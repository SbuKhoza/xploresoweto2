# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

hs_err_pid*.log
replay_pid*.log

# Ignore Firebase configuration files
android/app/google-services.json

# --- Firebase / secrets (never commit server credentials) ---
serviceAccount*.json
*-service-account*.json
*-firebase-adminsdk-*.json
functions/node_modules/
security-rules/node_modules/
functions/.env
functions/.env.*
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# --- Stage 2: local secrets for the Functions emulator (never commit) ---
functions/.secret.local
functions/.secret.*
