diff --git a/security-rules/storage.rules b/security-rules/storage.rules
new file mode 100644
index 0000000..8657e92
--- /dev/null
+++ b/security-rules/storage.rules
@@ -0,0 +1,78 @@
+// =====================================================================================================================
+// XploreSoweto Stage 1: Firebase Storage Rules (bucket xploresoweto.firebasestorage.app).   *** PREPARED, NOT DEPLOYED ***
+// Default deny. Staff = claim AND verified email AND an active authoritative Firestore record (cross-service lookup).
+// Note: download-token URLs bypass rules for anyone who holds the URL, so private documents (provider applications) are
+// never given token URLs; they are read only through authenticated SDK calls that these rules authorise.
+// =====================================================================================================================
+rules_version = '2';
+service firebase.storage {
+  match /b/{bucket}/o {
+
+    function signedIn() { return request.auth != null; }
+    function verified() { return signedIn() && request.auth.token.email_verified == true; }
+    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }
+    function isDocument() { return request.resource.contentType.matches('image/(jpeg|png)|application/pdf'); }
+    function underMB(n) { return request.resource.size < n * 1024 * 1024; }
+
+    function isActiveSuperAdmin() {
+      return verified()
+        && request.auth.token.get('superAdmin', false) == true
+        && firestore.get(/databases/(default)/documents/super-admin/$(request.auth.uid)).data.active == true
+        && firestore.get(/databases/(default)/documents/super-admin/$(request.auth.uid)).data.role == 'super_admin';
+    }
+    function isActiveEditor() {
+      return verified()
+        && request.auth.token.get('editor', false) == true
+        && firestore.get(/databases/(default)/documents/platform-editors/$(request.auth.uid)).data.active == true
+        && firestore.get(/databases/(default)/documents/platform-editors/$(request.auth.uid)).data.role == 'editor';
+    }
+    function isStaff() { return isActiveSuperAdmin() || isActiveEditor(); }
+
+    function membershipPath(orgId) { return /databases/(default)/documents/organisation-members/$(orgId + '_' + request.auth.uid); }
+    function orgPath(orgId) { return /databases/(default)/documents/organisations/$(orgId); }
+    function orgContentManager(orgId) {
+      return verified()
+        && firestore.exists(membershipPath(orgId))
+        && firestore.get(membershipPath(orgId)).data.active == true
+        && ('content.manage' in firestore.get(membershipPath(orgId)).data.permissions)
+        && firestore.get(membershipPath(orgId)).data.role in ['owner', 'manager', 'content_manager']
+        && firestore.get(orgPath(orgId)).data.approvalStatus == 'approved'
+        && firestore.get(orgPath(orgId)).data.active == true;
+    }
+
+    // ---- profile images: private to the owner
+    match /profile-images/{uid} {
+      allow read: if signedIn() && request.auth.uid == uid;
+      allow create, update: if signedIn() && request.auth.uid == uid && isImage() && underMB(2);
+      allow delete: if signedIn() && request.auth.uid == uid;
+    }
+
+    // ---- published media: public read; only active staff upload or remove. (Functions publish approved provider images here
+    //      using the Admin SDK, which bypasses rules.)
+    function publicFolder(f) {
+      return f in ['homescreen', 'news', 'events', 'attractions', 'business', 'restaurants', 'accommodations',
+                   'recreation', 'healthcare', 'publicservice'];
+    }
+    match /{folder}/{allPaths=**} {
+      allow read: if publicFolder(folder);
+      allow create, update: if publicFolder(folder) && isStaff() && isImage() && underMB(5);
+      allow delete: if publicFolder(folder) && isStaff();
+    }
+
+    // ---- provider listing submissions: members with content.manage of an approved organisation upload; they and staff read.
+    //      Immutable once uploaded (no update/delete from clients).
+    match /listing-submissions/{orgId}/{submissionId}/{file} {
+      allow read: if orgContentManager(orgId) || isStaff();
+      allow create: if orgContentManager(orgId) && submissionId.matches(orgId + '_.*') && isImage() && underMB(5);
+    }
+
+    // ---- provider application documents: private to the applicant and super admins; immutable
+    match /provider-applications/{uid}/{applicationId}/{file} {
+      allow read: if signedIn() && (request.auth.uid == uid || isActiveSuperAdmin());
+      allow create: if verified() && request.auth.uid == uid && applicationId.matches(uid + '_.*') && isDocument() && underMB(10);
+    }
+
+    // everything else (including person-of-interest/*) is denied
+    match /{allPaths=**} { allow read, write: if false; }
+  }
+}
diff --git a/security-rules/test/firestore.rules.test.js b/security-rules/test/firestore.rules.test.js
new file mode 100644
index 0000000..dba5f77
--- /dev/null
+++ b/security-rules/test/firestore.rules.test.js
@@ -0,0 +1,204 @@
+"use strict"
+const { assertFails, assertSucceeds } = require("@firebase/rules-unit-testing")
+const { doc, getDoc, getDocs, setDoc, addDoc, updateDoc, deleteDoc, collection, query, where } = require("firebase/firestore")
+const { makeEnv, seed, as } = require("./helpers")
+
+describe("Firestore rules (Stage 1, proposed)", () => {
+  let env
+  before(async () => { env = await makeEnv() })
+  after(async () => { await env.cleanup() })
+  beforeEach(async () => { await env.clearFirestore(); await seed(env); })
+  const anon = () => env.unauthenticatedContext().firestore()
+  const as_ = (uid, claims, verified) => as(env, uid, claims, verified).firestore()
+  const SA = { superAdmin: true }, ED = { editor: true }
+
+  describe("public content: the app's real queries", () => {
+    it("unauthenticated users can read an active document", () => assertSucceeds(getDoc(doc(anon(), "restaurants/r1"))))
+    it("the app's filtered list query (where isActive == true) works", () => assertSucceeds(getDocs(query(collection(anon(), "restaurants"), where("isActive", "==", true)))))
+    for (const c of ["accommodations", "attractions", "business", "restaurants", "recreation", "events", "news", "announcements", "transport", "healthcare", "emergency", "publicservice", "homescreen", "xplore-menu", "loadshedding"]) {
+      it(`filtered list works for ${c}`, () => assertSucceeds(getDocs(query(collection(as_("alice"), c), where("isActive", "==", true)))))
+    }
+    it("an UNFILTERED list query is rejected (rules are not filters)", () => assertFails(getDocs(collection(anon(), "restaurants"))))
+    it("inactive and flag-less documents are not readable", async () => {
+      await assertFails(getDoc(doc(anon(), "restaurants/r2"))); await assertFails(getDoc(doc(anon(), "restaurants/r3")))
+      await assertFails(getDocs(query(collection(anon(), "restaurants"), where("isActive", "==", false))))
+    })
+    it("ordinary users and anonymous visitors cannot write content", async () => {
+      await assertFails(updateDoc(doc(anon(), "restaurants/r1"), { name: "x" }))
+      await assertFails(setDoc(doc(as_("alice"), "restaurants/new"), { name: "x", isActive: true }))
+      await assertFails(deleteDoc(doc(as_("alice"), "restaurants/r1")))
+    })
+    it("collections outside the public list are closed", async () => {
+      for (const p of ["Person-Of-Interest/p1", "admin/x", "userservices/u1", "unknown/x"]) await assertFails(getDoc(doc(as_("alice"), p)))
+    })
+  })
+
+  describe("platform staff: a claim alone grants nothing", () => {
+    it("active editor (claim + verified + record) can write content", () => assertSucceeds(updateDoc(doc(as_("ed", ED), "restaurants/r1"), { name: "Renamed" })))
+    it("active super admin can write content and read super-admin/audit", async () => {
+      await assertSucceeds(updateDoc(doc(as_("root", SA), "restaurants/r1"), { name: "Renamed" }))
+      await assertSucceeds(getDoc(doc(as_("root", SA), "super-admin/root"))); await assertSucceeds(getDoc(doc(as_("root", SA), "audit-log/a1")))
+    })
+    it("claim WITHOUT a record is denied", async () => {
+      await assertFails(updateDoc(doc(as_("ghost", SA), "restaurants/r1"), { name: "x" }))
+      await assertFails(getDoc(doc(as_("ghost", SA), "super-admin/root")))
+      await assertFails(updateDoc(doc(as_("ghost", ED), "restaurants/r1"), { name: "x" }))
+    })
+    it("inactive record is denied even with the claim", async () => {
+      await assertFails(getDoc(doc(as_("exSA", SA), "super-admin/root")))
+      await assertFails(updateDoc(doc(as_("exEd", ED), "restaurants/r1"), { name: "x" }))
+    })
+    it("active record WITHOUT the claim is denied", async () => {
+      await assertFails(getDoc(doc(as_("root", {}), "super-admin/root")))
+      await assertFails(updateDoc(doc(as_("ed", {}), "restaurants/r1"), { name: "x" }))
+    })
+    it("an unverified email is denied", async () => {
+      await assertFails(getDoc(doc(as_("root", SA, false), "super-admin/root")))
+      await assertFails(updateDoc(doc(as_("ed", ED, false), "restaurants/r1"), { name: "x" }))
+    })
