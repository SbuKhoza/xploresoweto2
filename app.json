{
  "expo": {
    "name": "xploresoweto",
    "slug": "xploresoweto",
    "version": "1.0.3.beta",
    "orientation": "portrait",
    "icon": "./assets/Sowetoicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Sowetoicon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sbudamalloya.xploresoweto"
    },
    "web": {
      "favicon": "./assets/Sowetoicon.png"
    },
    "extra": {},
    "owner": "sbudamalloya",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Sowetoicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
