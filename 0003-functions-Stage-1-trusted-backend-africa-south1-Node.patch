diff --git a/functions/src/lib/platform.js b/functions/src/lib/platform.js
new file mode 100644
index 0000000..e43441f
--- /dev/null
+++ b/functions/src/lib/platform.js
@@ -0,0 +1,24 @@
+"use strict"
+// Platform roles. The Firestore record is AUTHORITATIVE; the custom claim is derived from it and is only ever
+// set/cleared here, after reading the record. A claim by itself never grants access (see guards.js).
+const fb = require("./firebase")
+const { COL } = require("./constants")
+
+const KINDS = Object.freeze({
+  superAdmin: { col: COL.superAdmin, claim: "superAdmin", role: "super_admin" },
+  editor: { col: COL.editors, claim: "editor", role: "editor" },
+})
+
+async function syncClaim(kindKey, uid) {
+  const kind = KINDS[kindKey]
+  const [rec, user] = await Promise.all([fb.db().collection(kind.col).doc(uid).get(), fb.auth().getUser(uid)])
+  const should = rec.exists && rec.data().active === true && rec.data().role === kind.role && rec.data().uid === uid
+  const claims = { ...(user.customClaims || {}) }
+  const has = claims[kind.claim] === true
+  if (should === has) return { changed: false, hasClaim: has }
+  if (should) claims[kind.claim] = true; else delete claims[kind.claim]
+  await fb.auth().setCustomUserClaims(uid, Object.keys(claims).length ? claims : null)
+  if (!should) await fb.auth().revokeRefreshTokens(uid) // existing sessions must refresh and lose the claim
+  return { changed: true, hasClaim: should }
+}
+module.exports = { KINDS, syncClaim }
diff --git a/functions/src/lib/validate.js b/functions/src/lib/validate.js
new file mode 100644
index 0000000..5ea355f
--- /dev/null
+++ b/functions/src/lib/validate.js
@@ -0,0 +1,64 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const bad = (m) => new HttpsError("invalid-argument", m)
+const CONTROL = /[\u0000-\u001f\u007f]/
+
+const isObject = (v) => v !== null && typeof v === "object" && !Array.isArray(v)
+function object(v, name = "data") { if (v === undefined || v === null) return {}; if (!isObject(v)) throw bad(`Invalid ${name}`); return v }
+function onlyKeys(obj, allowed, name = "data") {
+  for (const k of Object.keys(obj)) if (!allowed.includes(k)) throw bad(`Unknown field "${k}" in ${name}`)
+}
+function str(v, name, { min = 1, max = 200 } = {}) {
+  if (typeof v !== "string") throw bad(`${name} must be text`)
+  const t = v.trim()
+  if (t.length < min || t.length > max) throw bad(`${name} must be ${min}-${max} characters`)
+  if (CONTROL.test(t)) throw bad(`${name} contains invalid characters`)
+  return t
+}
+function optStr(v, name, { max = 200 } = {}) {
+  if (v === undefined || v === null || v === "") return undefined
+  return str(v, name, { min: 1, max })
+}
+function docId(v, name = "id") {
+  const s = str(v, name, { max: 200 })
+  if (!/^[A-Za-z0-9_.-]+$/.test(s) || s === "." || s === "..") throw bad(`Invalid ${name}`)
+  return s
+}
+function requestId(v) {
+  const s = str(v, "requestId", { min: 8, max: 64 })
+  if (!/^[A-Za-z0-9_-]+$/.test(s)) throw bad("Invalid requestId")
+  return s
+}
+function oneOf(v, name, list) { if (!list.includes(v)) throw bad(`Invalid ${name}`); return v }
+function intRange(v, name, min, max) {
+  if (!Number.isInteger(v) || v < min || v > max) throw bad(`${name} must be a whole number ${min}-${max}`)
+  return v
+}
+function email(v, name = "email") {
+  const s = str(v, name, { max: 254 }).toLowerCase()
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s)) throw bad(`Invalid ${name}`)
+  return s
+}
+function optPhone(v, name = "phone") {
+  if (v === undefined || v === null || v === "") return undefined
+  const s = str(v, name, { max: 20 })
+  if (!/^[0-9+()\-\s]{7,20}$/.test(s)) throw bad(`Invalid ${name}`)
+  return s
+}
+function ymd(v, name) {
+  const s = str(v, name, { min: 10, max: 10 })
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(s) || Number.isNaN(Date.parse(`${s}T00:00:00Z`))) throw bad(`Invalid ${name}`)
+  return s
+}
+function storagePaths(v, name, prefix, max) {
+  if (v === undefined || v === null) return []
+  if (!Array.isArray(v) || v.length > max) throw bad(`${name} must be a list of at most ${max} items`)
+  return v.map((p) => {
+    const s = str(p, name, { max: 300 })
+    if (!s.startsWith(prefix) || s.includes("..") || s.includes("//")) throw bad(`Invalid ${name}`)
+    return s
+  })
+}
+const maskEmail = (e) => { const [u, d] = String(e).split("@"); return `${u.slice(0, 1)}***@${d}` }
+
+module.exports = { bad, isObject, object, onlyKeys, str, optStr, docId, requestId, oneOf, intRange, email, optPhone, ymd, storagePaths, maskEmail }
diff --git a/functions/test/bootstrap.test.js b/functions/test/bootstrap.test.js
new file mode 100644
index 0000000..1e0c60e
--- /dev/null
+++ b/functions/test/bootstrap.test.js
@@ -0,0 +1,61 @@
+"use strict"
+const { test, beforeEach } = require("node:test")
+const assert = require("node:assert/strict")
+const { setup } = require("./helpers")
+const lib = require("../src/lib/bootstrap")
+
+let env
+const yes = async () => true
+const rec = (o = {}) => ({ uid: "root", email: "root@example.com", displayName: "Root", role: "super_admin", active: true, grantedBy: "manual-bootstrap", ...o })
+beforeEach(() => { env = setup(); env.addUser("root") })
+const refuses = (p, re) => assert.rejects(p, (e) => { assert.ok(e.bootstrap, `expected a controlled error, got: ${e.message}`); assert.match(e.message, re); return true })
+
+test("bootstrap refuses without an explicit uid (never chooses an account)", async () => { await refuses(lib.bootstrap({ confirm: yes }), /--uid is required/) })
+test("bootstrap refuses when the Authentication account does not exist", async () => { await refuses(lib.bootstrap({ uid: "ghost", confirm: yes }), /No Firebase Authentication account/) })
+test("bootstrap refuses when the manual record is missing, and does NOT create it", async () => {
+  await refuses(lib.bootstrap({ uid: "root", confirm: yes }), /No document super-admin\/root exists/)
+  assert.equal(env.get("super-admin/root"), undefined); assert.equal(env.auth.users.get("root").customClaims, undefined)
+})
+test("bootstrap refuses a malformed record: wrong uid field, wrong role, inactive, email mismatch, disabled account", async () => {
+  env.seed("super-admin/root", rec({ uid: "other" })); await refuses(lib.bootstrap({ uid: "root", confirm: yes }), /must equal the document id/)
+  env.seed("super-admin/root", rec({ role: "admin" })); await refuses(lib.bootstrap({ uid: "root", confirm: yes }), /"super_admin"/)
+  env.seed("super-admin/root", rec({ active: false })); await refuses(lib.bootstrap({ uid: "root", confirm: yes }), /must be true/)
+  env.seed("super-admin/root", rec({ email: "someone@else.com" })); await refuses(lib.bootstrap({ uid: "root", confirm: yes }), /does not match/)
+  env.seed("super-admin/root", rec()); env.auth.users.get("root").disabled = true; await refuses(lib.bootstrap({ uid: "root", confirm: yes }), /disabled/)
+  assert.equal(env.auth.users.get("root").customClaims, undefined)
+})
+test("bootstrap needs confirmation; without it nothing changes", async () => {
+  env.seed("super-admin/root", rec())
+  await refuses(lib.bootstrap({ uid: "root", confirm: async () => false }), /Not confirmed/)
+  assert.equal(env.auth.users.get("root").customClaims, undefined)
+})
+test("bootstrap sets and VERIFIES the claim, audits once, leaves the record untouched, and is idempotent", async () => {
+  env.seed("super-admin/root", rec()); const before = JSON.stringify(env.get("super-admin/root"))
+  const r = await lib.bootstrap({ uid: "root", confirm: yes })
+  assert.deepEqual([r.claimChanged, r.claimVerified, r.emailVerified], [true, true, true])
+  assert.deepEqual(env.auth.users.get("root").customClaims, { superAdmin: true })
+  assert.equal(JSON.stringify(env.get("super-admin/root")), before) // read-only for the authoritative record
+  assert.equal(env.list("audit-log").length, 1); assert.equal(env.list("audit-log")[0].action, "platform.superAdmin.bootstrap")
+  const again = await lib.bootstrap({ uid: "root", confirm: yes })
+  assert.equal(again.claimChanged, false); assert.equal(env.list("audit-log").length, 1)
+  assert.equal(env.list("super-admin").length, 1) // no extra records were created
+})
+test("an unverified admin account is allowed ONLY as a documented exception: flagged in the audit entry and in the result", async () => {
+  env.addUser("fresh", { emailVerified: false }); env.seed("super-admin/fresh", rec({ uid: "fresh", email: "fresh@example.com" }))
+  const r = await lib.bootstrap({ uid: "fresh", confirm: yes })
+  assert.equal(r.emailVerified, false)
+  assert.deepEqual([env.list("audit-log")[0].details.exception, env.list("audit-log")[0].details.emailVerified], [true, false])
+})
+test("bootstrap refuses to add a second active super admin unless --allow-multiple is given", async () => {
+  env.seed("super-admin/root", rec()); env.addUser("b"); env.seed("super-admin/b", rec({ uid: "b", email: "b@example.com" }))
+  await refuses(lib.bootstrap({ uid: "root", confirm: yes }), /Other active super-admin records exist/)
+  assert.equal((await lib.bootstrap({ uid: "root", allowMultiple: true, confirm: yes })).claimVerified, true)
+})
+test("sync clears the claim when the record is inactive; status reports orphans and drift", async () => {
+  env.seed("super-admin/root", rec()); await lib.bootstrap({ uid: "root", confirm: yes })
+  env.db._write({ type: "update", path: "super-admin/root", data: { active: false } })
+  const drift = await lib.status(); assert.ok(drift[0].problems.some((p) => /inactive but claim present/.test(p)))
+  await lib.syncOne("root"); assert.equal(env.auth.users.get("root").customClaims, undefined)
+  env.seed("super-admin/orphan", rec({ uid: "orphan", email: "o@example.com" }))
+  assert.ok((await lib.status()).find((r) => r.uid === "orphan").problems.some((p) => /ORPHAN/.test(p)))
+})
diff --git a/functions/test/fake.js b/functions/test/fake.js
new file mode 100644
index 0000000..4692e2b
--- /dev/null
+++ b/functions/test/fake.js
@@ -0,0 +1,134 @@
+"use strict"
+// In-memory stand-in for the parts of firebase-admin the functions use. It models the behaviours that matter for correctness:
+// optimistic-concurrency transactions (retry on conflict), reads-before-writes, create() on existing docs failing, update() on
+// missing docs failing, FieldValue sentinels, and equality queries. It is NOT the Firebase emulator and does not run Security Rules.
+const clock = require("../src/lib/clock")
+
+class Ts {
+  constructor(ms) { this.ms = ms }
+  toMillis() { return this.ms }
+  toDate() { return new Date(this.ms) }
+  static fromMillis(ms) { return new Ts(ms) }
+  static fromDate(d) { return new Ts(d.getTime()) }
+}
+const SERVER = { __fv: "serverTimestamp" }
+const DELETE = { __fv: "delete" }
+const FieldValue = { serverTimestamp: () => SERVER, delete: () => DELETE }
+
+const clone = (v) => {
+  if (v instanceof Ts) return new Ts(v.ms)
+  if (Array.isArray(v)) return v.map(clone)
+  if (v && typeof v === "object") return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, clone(x)]))
+  return v
+}
+const eq = (a, b) => (a instanceof Ts && b instanceof Ts ? a.ms === b.ms : a === b)
+const nowTs = () => new Ts(clock.now().getTime())
+const resolveValue = (v) => (v === SERVER ? nowTs() : v && typeof v === "object" && !(v instanceof Ts) && !Array.isArray(v) ? resolveObject(v) : Array.isArray(v) ? v.map(resolveValue) : v)
+const resolveObject = (o) => Object.fromEntries(Object.entries(o).filter(([, x]) => x !== DELETE).map(([k, x]) => [k, resolveValue(x)]))
+const assertNoUndefined = (o, p = "") => {
+  for (const [k, v] of Object.entries(o)) {
+    if (v === undefined) throw new Error(`Firestore would reject undefined at ${p}${k}`)
+    if (v && typeof v === "object" && !(v instanceof Ts) && v !== SERVER && v !== DELETE) assertNoUndefined(Array.isArray(v) ? Object.fromEntries(v.map((x, i) => [i, x])) : v, `${p}${k}.`)
+  }
+}
+
+class FakeFirestore {
+  constructor() { this.store = new Map(); this.ver = new Map(); this.colVer = new Map(); this.seq = 0 }
+  collection(name) { return new Col(this, name) }
+  batch() { return new Batch(this) }
+  _read(path) { const d = this.store.get(path); return d ? clone(d) : undefined }
+  _version(path) { return this.ver.get(path) || 0 }
+  _bump(path) { this.ver.set(path, this._version(path) + 1); const c = path.split("/")[0]; this.colVer.set(c, (this.colVer.get(c) || 0) + 1) }
+  _write(op) {
+    const { type, path, data } = op
+    const cur = this.store.get(path)
+    if (type === "create") { if (cur) throw Object.assign(new Error("ALREADY_EXISTS"), { code: 6 }); }
+    if (type === "update" && !cur) throw Object.assign(new Error(`NOT_FOUND: ${path}`), { code: 5 })
+    if (type === "delete") { this.store.delete(path); this._bump(path); return }
+    assertNoUndefined(data)
+    if (type === "set" || type === "create") this.store.set(path, clone(resolveObject(data)))
+    else {
+      const next = clone(cur)
+      for (const [k, v] of Object.entries(data)) { if (v === DELETE) delete next[k]; else next[k] = resolveValue(v) }
+      this.store.set(path, next)
+    }
+    this._bump(path)
+  }
+  _list(col) { return [...this.store.keys()].filter((p) => p.startsWith(`${col}/`) && p.split("/").length === 2) }
+  async runTransaction(fn) {
+    for (let attempt = 0; attempt < 6; attempt++) {
+      const tx = new Tx(this)
+      const result = await fn(tx)
+      if (tx.conflict()) continue // someone else committed to something we read: retry like Firestore does
+      tx.ops.forEach((op) => this._write(op))
+      return result
+    }
+    throw Object.assign(new Error("ABORTED: too much contention"), { code: 10 })
+  }
+}
+class Col {
+  constructor(db, name) { this.db = db; this.name = name }
+  doc(id) { return new DocRef(this.db, this.name, id || `auto${++this.db.seq}`) }
+  where(f, op, v) { return new Query(this.db, this.name, []).where(f, op, v) }
+  limit(n) { return new Query(this.db, this.name, []).limit(n) }
+  get() { return new Query(this.db, this.name, []).get() }
+}
+class DocRef {
+  constructor(db, col, id) { this.db = db; this.col = col; this.id = id; this.path = `${col}/${id}` }
+  async get() { const d = this.db._read(this.path); return new DocSnap(this, d) }
+  async set(data) { this.db._write({ type: "set", path: this.path, data }) }
+  async update(data) { this.db._write({ type: "update", path: this.path, data }) }
+}
+class DocSnap { constructor(ref, d) { this.ref = ref; this.id = ref.id; this.exists = d !== undefined; this._d = d } data() { return this._d ? clone(this._d) : undefined } }
+class Query {
+  constructor(db, col, filters, lim) { this.db = db; this.col = col; this.filters = filters; this.lim = lim }
+  where(f, op, v) { if (op !== "==") throw new Error(`fake supports == only (got ${op})`); return new Query(this.db, this.col, [...this.filters, [f, v]], this.lim) }
+  limit(n) { return new Query(this.db, this.col, this.filters, n) }
+  async get() {
+    let paths = this.db._list(this.col).filter((p) => { const d = this.db.store.get(p); return this.filters.every(([f, v]) => eq(d[f], v)) })
+    if (this.lim) paths = paths.slice(0, this.lim)
+    return new QuerySnap(paths.map((p) => new DocSnap(new DocRef(this.db, this.col, p.split("/")[1]), this.db._read(p))))
+  }
+}
+class QuerySnap { constructor(docs) { this.docs = docs; this.size = docs.length; this.empty = docs.length === 0 } forEach(fn) { this.docs.forEach(fn) } }
+class Tx {
+  constructor(db) { this.db = db; this.ops = []; this.reads = []; this.colReads = [] }
+  async get(refOrQuery) {
+    if (this.ops.length) throw new Error("Firestore transactions require all reads to be executed before all writes")
+    if (refOrQuery instanceof DocRef) { this.reads.push([refOrQuery.path, this.db._version(refOrQuery.path)]); return refOrQuery.get() }
+    this.colReads.push([refOrQuery.col, this.db.colVer.get(refOrQuery.col) || 0])
+    return refOrQuery.get()
+  }
+  set(ref, data) { this.ops.push({ type: "set", path: ref.path, data }); return this }
+  create(ref, data) { this.ops.push({ type: "create", path: ref.path, data }); return this }
+  update(ref, data) { this.ops.push({ type: "update", path: ref.path, data }); return this }
+  conflict() { return this.reads.some(([p, v]) => this.db._version(p) !== v) || this.colReads.some(([c, v]) => (this.db.colVer.get(c) || 0) !== v) }
+}
+class Batch {
+  constructor(db) { this.db = db; this.ops = [] }
+  set(ref, data) { this.ops.push({ type: "set", path: ref.path, data }); return this }
+  update(ref, data) { this.ops.push({ type: "update", path: ref.path, data }); return this }
+  async commit() { this.ops.forEach((op) => this.db._write(op)) }
+}
+
+class FakeAuth {
+  constructor() { this.users = new Map(); this.revoked = [] }
+  addUser(u) { this.users.set(u.uid, { customClaims: undefined, emailVerified: false, displayName: null, ...u }); return u.uid }
+  async getUser(uid) { const u = this.users.get(uid); if (!u) throw Object.assign(new Error("no user"), { code: "auth/user-not-found" }); return { ...u } }
+  async getUserByEmail(email) { const u = [...this.users.values()].find((x) => x.email === email); if (!u) throw Object.assign(new Error("no user"), { code: "auth/user-not-found" }); return { ...u } }
+  async setCustomUserClaims(uid, claims) { this.users.get(uid).customClaims = claims || undefined }
+  async revokeRefreshTokens(uid) { this.revoked.push(uid) }
+}
+class FakeBucket {
+  constructor() { this.name = "xploresoweto.firebasestorage.app"; this.files = new Set(); this.copies = [] }
+  put(path) { this.files.add(path); return this }
+  file(path) { const b = this; return { path, async copy(dest) { if (!b.files.has(path)) throw new Error(`source missing: ${path}`); b.files.add(dest.path); b.copies.push([path, dest.path]) } } }
+}
+function makeFakeAdmin() {
+  const db = new FakeFirestore(), auth = new FakeAuth(), bucket = new FakeBucket()
+  const firestore = () => db
+  firestore.FieldValue = FieldValue
+  firestore.Timestamp = Ts
+  return { admin: { firestore, auth: () => auth, storage: () => ({ bucket: () => bucket }), apps: [{}], initializeApp() {} }, db, auth, bucket }
+}
+module.exports = { makeFakeAdmin, Ts }
