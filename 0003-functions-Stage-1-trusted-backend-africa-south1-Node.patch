+  await rejects(sub("contentA", { imagePaths: ["listing-submissions/orgB/orgB_req-00000001/a.jpg"] }), "invalid-argument")
+  await rejects(sub("contentA", { imagePaths: ["listing-submissions/orgA/orgA_req-00000001/../x.jpg"] }), "invalid-argument")
+  await rejects(L.submitListing(req("guide", { requestId: "req-00000001", organisationId: "orgT", kind: "new", payload: { name: "Tour" } })), "failed-precondition", "listing-type-not-supported-yet")
+})
+test("reviewListingSubmission: only active staff; approval publishes isActive+organisationId, copies images, idempotent", async () => {
+  env.bucket.put("listing-submissions/orgA/orgA_req-00000001/front.jpg")
+  await sub("contentA", { imagePaths: ["listing-submissions/orgA/orgA_req-00000001/front.jpg"] })
+  await rejects(L.reviewListingSubmission(req("contentA", { submissionId: "orgA_req-00000001", decision: "approve" })), "permission-denied")
+  await rejects(L.reviewListingSubmission(req("plain", { submissionId: "orgA_req-00000001", decision: "approve" }, { claims: { editor: true } })), "permission-denied") // claim without record
+  const r = await L.reviewListingSubmission(editor({ submissionId: "orgA_req-00000001", decision: "approve" }))
+  assert.deepEqual([r.status, r.duplicate], ["approved", false])
+  const pub = env.get("restaurants/orgA_req-00000001")
+  assert.deepEqual([pub.name, pub.isActive, pub.organisationId, pub.publishedBy], ["Mama Kitchen", true, "orgA", "ed"])
+  assert.equal(pub.images.length, 1); assert.match(pub.images[0], /^https:\/\/firebasestorage\.googleapis\.com\/v0\/b\/xploresoweto\.firebasestorage\.app\/o\/restaurants%2ForgA%2F/)
+  assert.equal(env.bucket.copies.length, 1)
+  assert.equal((await L.reviewListingSubmission(editor({ submissionId: "orgA_req-00000001", decision: "approve" }))).duplicate, true)
+  assert.equal(env.list("restaurants").length, 1)
+  assert.equal(env.list("audit-log").filter((a) => a.action === "listing.publish").length, 1)
+})
+test("reviewListingSubmission: reject; a suspended organisation cannot publish; change requests cannot touch another organisation's listing", async () => {
+  await sub("contentA"); const sa = makeSuperAdmin(env, "root")
+  assert.equal((await L.reviewListingSubmission(sa({ submissionId: "orgA_req-00000001", decision: "reject", note: "needs photos" }))).status, "rejected")
+  assert.equal(env.list("restaurants").length, 0)
+  await sub("contentA", { requestId: "req-00000002" })
+  env.db._write({ type: "update", path: "organisations/orgA", data: { approvalStatus: "suspended", active: false } })
+  await rejects(L.reviewListingSubmission(sa({ submissionId: "orgA_req-00000002", decision: "approve" })), "failed-precondition", "organisation-inactive")
+  env.db._write({ type: "update", path: "organisations/orgA", data: { approvalStatus: "approved", active: true } })
+  env.seed("restaurants/foreign", { name: "Not theirs", organisationId: "orgB", isActive: true })
+  await L.submitListing(req("contentA", { requestId: "req-00000003", organisationId: "orgA", kind: "change", targetDocId: "foreign", payload: { description: "hijack" } }))
+  await rejects(L.reviewListingSubmission(sa({ submissionId: "orgA_req-00000003", decision: "approve" })), "failed-precondition", "target-not-owned-by-organisation")
+  assert.notEqual(env.get("restaurants/foreign").description, "hijack")
+})
diff --git a/functions/test/organisations.test.js b/functions/test/organisations.test.js
new file mode 100644
index 0000000..61faa1c
--- /dev/null
+++ b/functions/test/organisations.test.js
@@ -0,0 +1,103 @@
+"use strict"
+const { test, beforeEach } = require("node:test")
+const assert = require("node:assert/strict")
+const { setup, req, rejects, makeSuperAdmin, makeOrg, addMember } = require("./helpers")
+const { submitProviderApplication, reviewProviderApplication } = require("../src/handlers/applications")
+const { setOrganisationStatus } = require("../src/handlers/organisations")
+
+let env, sa
+beforeEach(() => { env = setup(); sa = makeSuperAdmin(env, "root"); env.addUser("alice"); env.addUser("bob") })
+
+const application = (o = {}) => ({ requestId: "req-00000001", organisationType: "restaurant", organisationName: "Mama's Kitchen", description: "Home cooking", contact: { phone: "0110000000" }, documentPaths: [], ...o })
+
+test("provider application: unverified email cannot submit; unauthenticated cannot submit", async () => {
+  await rejects(submitProviderApplication(req("alice", application(), { verified: false })), "failed-precondition", "email-not-verified")
+  await rejects(submitProviderApplication({ data: application() }), "unauthenticated")
+  assert.equal(env.list("provider-applications").length, 0)
+})
+test("provider application: created with a deterministic id; a duplicate request returns the same record", async () => {
+  const a = await submitProviderApplication(req("alice", application()))
+  assert.equal(a.applicationId, "alice_req-00000001"); assert.equal(a.duplicate, false)
+  const b = await submitProviderApplication(req("alice", application({ organisationName: "Changed Name" })))
+  assert.equal(b.duplicate, true)
+  assert.equal(env.list("provider-applications").length, 1)
+  assert.equal(env.get("provider-applications/alice_req-00000001").organisationName, "Mama's Kitchen")
+  assert.equal(env.get("provider-applications/alice_req-00000001").status, "submitted")
+})
+test("provider application: validation, forbidden fields, foreign document paths", async () => {
+  await rejects(submitProviderApplication(req("alice", application({ status: "approved" }))), "invalid-argument")
+  await rejects(submitProviderApplication(req("alice", application({ organisationType: "casino" }))), "invalid-argument")
+  await rejects(submitProviderApplication(req("alice", application({ organisationName: "x" }))), "invalid-argument")
+  await rejects(submitProviderApplication(req("alice", application({ documentPaths: ["provider-applications/bob/x/doc.pdf"] }))), "invalid-argument")
+  await rejects(submitProviderApplication(req("alice", application({ documentPaths: ["provider-applications/alice/../bob/doc.pdf"] }))), "invalid-argument")
+  const ok = await submitProviderApplication(req("alice", application({ documentPaths: ["provider-applications/alice/a1/reg.pdf"] })))
+  assert.equal(ok.status, "submitted")
+})
+test("provider application: at most 3 open applications per user", async () => {
+  for (let i = 1; i <= 3; i++) await submitProviderApplication(req("alice", application({ requestId: `req-0000000${i}` })))
+  await rejects(submitProviderApplication(req("alice", application({ requestId: "req-00000009" }))), "resource-exhausted")
+  await submitProviderApplication(req("bob", application({ requestId: "req-00000001" }))) // another user unaffected
+})
+test("review: applicants and ordinary users cannot approve (including their own)", async () => {
+  await submitProviderApplication(req("alice", application()))
+  await rejects(reviewProviderApplication(req("alice", { applicationId: "alice_req-00000001", decision: "approve" })), "permission-denied")
+  await rejects(reviewProviderApplication(req("bob", { applicationId: "alice_req-00000001", decision: "approve" })), "permission-denied")
+  assert.equal(env.list("organisations").length, 0)
+})
+test("review: a super admin cannot approve their OWN application", async () => {
+  env.seed("provider-applications/root_req-1", { applicantUid: "root", organisationType: "business", organisationName: "Mine", status: "submitted", contact: {} })
+  await rejects(reviewProviderApplication(sa({ applicationId: "root_req-1", decision: "approve" })), "permission-denied", "cannot-review-own-application")
+})
+test("review: approval creates exactly one organisation and one owner membership; repeating it creates no duplicates", async () => {
+  await submitProviderApplication(req("alice", application()))
+  const r1 = await reviewProviderApplication(sa({ applicationId: "alice_req-00000001", decision: "approve", note: "ok" }))
+  assert.deepEqual([r1.status, r1.duplicate, r1.organisationId], ["approved", false, "alice_req-00000001"])
+  const r2 = await reviewProviderApplication(sa({ applicationId: "alice_req-00000001", decision: "approve" }))
+  assert.equal(r2.duplicate, true)
+  const orgs = env.list("organisations"), members = env.list("organisation-members")
+  assert.equal(orgs.length, 1); assert.equal(members.length, 1)
+  assert.deepEqual([orgs[0].ownerUid, orgs[0].approvalStatus, orgs[0].active, orgs[0].verificationStatus], ["alice", "approved", true, "verified"])
+  assert.deepEqual([members[0].id, members[0].role, members[0].active], ["alice_req-00000001_alice", "owner", true])
+  assert.ok(members[0].permissions.includes("members.manage"))
+  assert.equal(env.list("audit-log").filter((a) => a.action === "provider.approve").length, 1)
+  assert.equal(env.get("provider-applications/alice_req-00000001").status, "approved")
+})
+test("review: reject, then approving a rejected application is refused", async () => {
+  await submitProviderApplication(req("alice", application()))
+  assert.equal((await reviewProviderApplication(sa({ applicationId: "alice_req-00000001", decision: "reject", note: "incomplete" }))).status, "rejected")
+  await rejects(reviewProviderApplication(sa({ applicationId: "alice_req-00000001", decision: "approve" })), "failed-precondition")
+  assert.equal(env.list("organisations").length, 0)
+  assert.equal(env.list("audit-log").filter((a) => a.action === "provider.reject").length, 1)
+})
+test("review: concurrent approvals still create exactly one organisation", async () => {
+  await submitProviderApplication(req("alice", application()))
+  await Promise.all(Array.from({ length: 4 }, () => reviewProviderApplication(sa({ applicationId: "alice_req-00000001", decision: "approve" }))))
+  assert.equal(env.list("organisations").length, 1); assert.equal(env.list("organisation-members").length, 1)
+  assert.equal(env.list("audit-log").filter((a) => a.action === "provider.approve").length, 1)
+})
+test("review: a user can be a visitor AND own several organisations", async () => {
+  await submitProviderApplication(req("alice", application({ requestId: "req-00000001" })))
+  await submitProviderApplication(req("alice", application({ requestId: "req-00000002", organisationType: "accommodation", organisationName: "Guest House" })))
+  await reviewProviderApplication(sa({ applicationId: "alice_req-00000001", decision: "approve" }))
+  await reviewProviderApplication(sa({ applicationId: "alice_req-00000002", decision: "approve" }))
+  assert.equal(env.list("organisation-members").filter((m) => m.userId === "alice" && m.role === "owner").length, 2)
+})
+test("setOrganisationStatus: super admin only; reason required; suspends and restores listings it hid", async () => {
+  makeOrg(env, "orgA"); makeOrg(env, "orgB")
+  env.seed("restaurants/r1", { name: "R1", organisationId: "orgA", isActive: true })
+  env.seed("restaurants/r2", { name: "R2", organisationId: "orgA", isActive: false }) // staff-deactivated earlier
+  env.seed("business/b1", { name: "B1", organisationId: "orgB", isActive: true })
+  await rejects(setOrganisationStatus(req("alice", { organisationId: "orgA", status: "suspended", reason: "x" })), "permission-denied")
+  await rejects(setOrganisationStatus(sa({ organisationId: "orgA", status: "suspended" })), "invalid-argument")
+  const s = await setOrganisationStatus(sa({ organisationId: "orgA", status: "suspended", reason: "Complaint upheld" }))
+  assert.deepEqual([s.changed, s.listingsUpdated], [true, 1])
+  assert.deepEqual([env.get("organisations/orgA").approvalStatus, env.get("organisations/orgA").active], ["suspended", false])
+  assert.equal(env.get("restaurants/r1").isActive, false); assert.equal(env.get("business/b1").isActive, true) // other org untouched
+  const again = await setOrganisationStatus(sa({ organisationId: "orgA", status: "suspended", reason: "Complaint upheld" }))
+  assert.equal(again.changed, false)
+  await setOrganisationStatus(sa({ organisationId: "orgA", status: "approved" }))
+  assert.equal(env.get("restaurants/r1").isActive, true)
+  assert.equal(env.get("restaurants/r2").isActive, false) // NOT re-activated: it was not hidden by the suspension
+  assert.ok(!("suspendedByOrganisation" in env.get("restaurants/r1")))
+  assert.deepEqual(env.list("audit-log").map((a) => a.action).sort(), ["organisation.restore", "organisation.suspend"])
+})
diff --git a/functions/test/platform.test.js b/functions/test/platform.test.js
new file mode 100644
index 0000000..f9d1bae
--- /dev/null
+++ b/functions/test/platform.test.js
@@ -0,0 +1,143 @@
+"use strict"
+const { test, beforeEach } = require("node:test")
+const assert = require("node:assert/strict")
+const { setup, req, rejects, makeSuperAdmin } = require("./helpers")
+const G = require("../src/lib/guards")
+const { managePlatformRole } = require("../src/handlers/platform")
+const { seedLoadshedding } = require("../src/handlers/loadshedding")
+
+let env
+beforeEach(() => { env = setup() })
+
+test("guard: valid super admin (claim + active record + verified) passes", async () => {
+  const sa = makeSuperAdmin(env, "root")
+  assert.equal((await G.requireActiveSuperAdmin(sa({}))).uid, "root")
+})
+test("guard: unauthenticated denied", async () => { await rejects(G.requireActiveSuperAdmin({ data: {} }), "unauthenticated") })
+test("guard: claim WITHOUT an active record is denied", async () => {
+  env.addUser("fake")
+  await rejects(G.requireActiveSuperAdmin(req("fake", {}, { claims: { superAdmin: true } })), "permission-denied")
+})
+test("guard: inactive record is denied even with the claim", async () => {
+  const sa = makeSuperAdmin(env, "ex", { active: false })
+  await rejects(G.requireActiveSuperAdmin(sa({})), "permission-denied")
+})
+test("guard: active record WITHOUT the claim is denied", async () => {
+  const sa = makeSuperAdmin(env, "noclaim", { claim: false })
+  await rejects(G.requireActiveSuperAdmin(sa({})), "permission-denied")
+})
+test("guard: record with the wrong role or mismatched uid is denied", async () => {
+  const sa = makeSuperAdmin(env, "wrongrole", { role: "editor" })
+  await rejects(G.requireActiveSuperAdmin(sa({})), "permission-denied")
+  env.addUser("mismatch", { customClaims: { superAdmin: true } })
+  env.seed("super-admin/mismatch", { uid: "someone-else", role: "super_admin", active: true })
+  await rejects(G.requireActiveSuperAdmin(req("mismatch", {}, { claims: { superAdmin: true } })), "permission-denied")
+})
+test("guard: unverified email is refused", async () => {
+  const sa = makeSuperAdmin(env, "unv")
+  await rejects(G.requireActiveSuperAdmin(sa({}, { verified: false })), "failed-precondition", "email-not-verified")
+})
+test("guard: a user can never grant themselves access by sending claims-like data", async () => {
+  env.addUser("evil")
+  await rejects(managePlatformRole(req("evil", { action: "add", role: "superAdmin", uid: "evil", isAdmin: true })), "permission-denied")
+  assert.equal(env.get("super-admin/evil"), undefined)
+})
+test("editors cannot manage platform roles", async () => {
+  env.addUser("ed", { customClaims: { editor: true } })
+  env.seed("platform-editors/ed", { uid: "ed", role: "editor", active: true })
+  await rejects(managePlatformRole(req("ed", { action: "add", role: "editor", uid: "ed" }, { claims: { editor: true } })), "permission-denied")
+})
+test("add: creates the authoritative record, derives the claim, audits once; repeat is a no-op", async () => {
+  const sa = makeSuperAdmin(env, "root"); env.addUser("second")
+  const r = await managePlatformRole(sa({ action: "add", role: "superAdmin", uid: "second" }))
+  assert.equal(r.changed, true)
+  const rec = env.get("super-admin/second")
+  assert.deepEqual([rec.uid, rec.role, rec.active, rec.grantedBy, rec.email], ["second", "super_admin", true, "root", "second@example.com"])
+  assert.deepEqual(env.auth.users.get("second").customClaims, { superAdmin: true })
+  assert.equal(env.list("audit-log").length, 1)
+  const again = await managePlatformRole(sa({ action: "add", role: "superAdmin", uid: "second" }))
+  assert.equal(again.changed, false); assert.equal(env.list("audit-log").length, 1)
+})
+test("add: target must exist and have a verified email", async () => {
+  const sa = makeSuperAdmin(env, "root")
+  await rejects(managePlatformRole(sa({ action: "add", role: "editor", uid: "ghost" })), "not-found")
+  env.addUser("unv", { emailVerified: false })
+  await rejects(managePlatformRole(sa({ action: "add", role: "editor", uid: "unv" })), "failed-precondition", "target-email-not-verified")
+})
+test("add: a claim lost earlier is repaired by repeating the call", async () => {
+  const sa = makeSuperAdmin(env, "root"); env.addUser("x")
+  env.seed("platform-editors/x", { uid: "x", role: "editor", active: true })
+  const r = await managePlatformRole(sa({ action: "add", role: "editor", uid: "x" }))
+  assert.equal(r.changed, false); assert.equal(r.claimChanged, true)
+  assert.deepEqual(env.auth.users.get("x").customClaims, { editor: true })
+})
+test("remove: the last active super admin cannot be removed; self-removal is refused", async () => {
+  const sa = makeSuperAdmin(env, "root")
+  await rejects(managePlatformRole(sa({ action: "remove", role: "superAdmin", uid: "root" })), "failed-precondition", "cannot-remove-self")
+  env.addUser("b"); await managePlatformRole(sa({ action: "add", role: "superAdmin", uid: "b" }))
+  // b tries to remove root while both active: allowed (two admins). Then root remains the only one -> can't remove it
+  const sb = (d) => req("b", d, { claims: { superAdmin: true } })
+  await managePlatformRole(sb({ action: "remove", role: "superAdmin", uid: "root" }))
+  await rejects(managePlatformRole(sb({ action: "remove", role: "superAdmin", uid: "b" })), "failed-precondition", "cannot-remove-self")
+  env.addUser("c", {}); env.seed("super-admin/c", { uid: "c", role: "super_admin", active: true })
+  await managePlatformRole(sb({ action: "remove", role: "superAdmin", uid: "c" }))
+  const onlyOne = env.list("super-admin").filter((x) => x.active)
+  assert.equal(onlyOne.length, 1)
+  // two admins -> a third party cannot reduce below one
+  env.addUser("d"); await managePlatformRole(sb({ action: "add", role: "superAdmin", uid: "d" }))
+  const sd = (data) => req("d", data, { claims: { superAdmin: true } })
+  await managePlatformRole(sd({ action: "remove", role: "superAdmin", uid: "b" }))
+  await rejects(managePlatformRole(req("b", { action: "remove", role: "superAdmin", uid: "d" }, { claims: { superAdmin: true } })), "permission-denied") // b was revoked: stale token claim is useless
+})
+test("last-admin protection holds even when the caller is a different (stale) admin record", async () => {
+  const sa = makeSuperAdmin(env, "only")
+  env.addUser("target"); env.seed("super-admin/target", { uid: "target", role: "super_admin", active: false })
+  // only one active admin exists (caller). Removing someone else who is inactive is a no-op, not an error
+  const r = await managePlatformRole(sa({ action: "remove", role: "superAdmin", uid: "target" }))
+  assert.equal(r.changed, false)
+})
+test("revocation takes effect immediately: claim cleared, sessions revoked, stale token denied", async () => {
+  const sa = makeSuperAdmin(env, "root"); env.addUser("b")
+  await managePlatformRole(sa({ action: "add", role: "superAdmin", uid: "b" }))
+  await managePlatformRole(sa({ action: "remove", role: "superAdmin", uid: "b" }))
+  assert.equal(env.get("super-admin/b").active, false)
+  assert.equal(env.auth.users.get("b").customClaims, undefined)
+  assert.deepEqual(env.auth.revoked, ["b"])
+  await rejects(G.requireActiveSuperAdmin(req("b", {}, { claims: { superAdmin: true } })), "permission-denied")
+})
+test("seedLoadshedding: super admin only, validates, never overwrites by default, audits", async () => {
+  const sa = makeSuperAdmin(env, "root"); env.addUser("u")
+  const item = { suburb: "Orlando East", schedule: { stage_1: { monday: ["06:00 - 08:30"], tuesday: [] } } }
+  await rejects(seedLoadshedding(req("u", { schedules: [item] })), "permission-denied")
+  await rejects(seedLoadshedding(sa({ schedules: [] })), "invalid-argument")
+  await rejects(seedLoadshedding(sa({ schedules: [{ suburb: "X", schedule: { stage_9: {} } }] })), "invalid-argument")
+  await rejects(seedLoadshedding(sa({ schedules: [{ suburb: "X", schedule: { stage_1: { monday: ["bad"] } } }] })), "invalid-argument")
+  await rejects(seedLoadshedding(sa({ schedules: [item], extra: 1 })), "invalid-argument")
+  const r = await seedLoadshedding(sa({ schedules: [item] }))
+  assert.deepEqual([r.created, r.skipped], [1, 0])
+  const doc = env.get("loadshedding/orlando east")
+  assert.equal(doc.isActive, true); assert.equal(doc.seededBy, "root")
+  const changed = { ...item, schedule: { stage_1: { monday: ["10:00 - 12:30"] } } }
+  const again = await seedLoadshedding(sa({ schedules: [changed] }))
+  assert.deepEqual([again.created, again.skipped], [0, 1])
+  assert.deepEqual(env.get("loadshedding/orlando east").schedule.stage_1.monday, ["06:00 - 08:30"]) // untouched
+  await rejects(seedLoadshedding(sa({ schedules: [changed], overwrite: true })), "invalid-argument")
+  const ow = await seedLoadshedding(sa({ schedules: [changed], overwrite: true, confirmOverwrite: "OVERWRITE" }))
+  assert.equal(ow.overwritten, 1)
+  assert.deepEqual(env.get("loadshedding/orlando east").schedule.stage_1.monday, ["10:00 - 12:30"])
+})
+
+test("RACE: two super admins removing each other at the same moment can never leave zero active super admins", async () => {
+  const sa = makeSuperAdmin(env, "a"); const sb = makeSuperAdmin(env, "b")
+  for (let round = 0; round < 3; round++) {
+    env.seed("super-admin/a", { uid: "a", email: "a@example.com", role: "super_admin", active: true })
+    env.seed("super-admin/b", { uid: "b", email: "b@example.com", role: "super_admin", active: true })
+    const results = await Promise.allSettled([
+      managePlatformRole(sa({ action: "remove", role: "superAdmin", uid: "b" })),
+      managePlatformRole(sb({ action: "remove", role: "superAdmin", uid: "a" })),
+    ])
+    const active = env.list("super-admin").filter((x) => x.active).length
+    assert.ok(active >= 1, `round ${round}: ${active} active super admins remain`)
+    assert.ok(results.some((r) => r.status === "rejected" && /last-super-admin/.test(r.reason.message)), "one of the two removals must be refused")
+  }
+})
diff --git a/functions/test/profile.test.js b/functions/test/profile.test.js
new file mode 100644
