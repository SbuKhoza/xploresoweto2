@@ -0,0 +1,15 @@
+#!/usr/bin/env node
+"use strict"
+// Calls a deployed callable function as a signed-in user (e.g. a Super Admin running seedLoadshedding) using only fetch.
+//   ADMIN_EMAIL=... ADMIN_PASSWORD=... node scripts/call.js seedLoadshedding '{"schedules":[...]}'
+// Credentials come from the environment, never from files. Uses the app's PUBLIC web API key to sign in via the Auth REST API.
+const API_KEY = "AIzaSyCwRLeFV0lxbez-G3YONR-WIcdgF3xSUpg"
+const PROJECT = "xploresoweto", REGION = "africa-south1"
+;(async () => {
+  const [name, json] = process.argv.slice(2)
+  if (!name || !process.env.ADMIN_EMAIL || !process.env.ADMIN_PASSWORD) { console.error("Usage: ADMIN_EMAIL=.. ADMIN_PASSWORD=.. node scripts/call.js <function> '<json data>'"); process.exit(1) }
+  const login = await fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=${API_KEY}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: process.env.ADMIN_EMAIL, password: process.env.ADMIN_PASSWORD, returnSecureToken: true }) }).then((r) => r.json())
+  if (!login.idToken) { console.error("Sign-in failed:", login.error?.message); process.exit(1) }
+  const res = await fetch(`https://${REGION}-${PROJECT}.cloudfunctions.net/${name}`, { method: "POST", headers: { "Content-Type": "application/json", Authorization: `Bearer ${login.idToken}` }, body: JSON.stringify({ data: json ? JSON.parse(json) : {} }) })
+  console.log(res.status, JSON.stringify(await res.json(), null, 2))
+})().catch((e) => { console.error(e.message); process.exit(1) })
diff --git a/functions/scripts/super-admin.js b/functions/scripts/super-admin.js
new file mode 100644
index 0000000..9fd2023
--- /dev/null
+++ b/functions/scripts/super-admin.js
@@ -0,0 +1,55 @@
+#!/usr/bin/env node
+"use strict"
+/**
+ * Super-admin bootstrap helper (trusted, run by a human; read-only for the `super-admin` collection).
+ *
+ *   node scripts/super-admin.js status
+ *   node scripts/super-admin.js bootstrap --uid <FIREBASE_AUTH_UID> [--confirm-email <email>] [--allow-multiple]
+ *   node scripts/super-admin.js sync      --uid <FIREBASE_AUTH_UID>     (align the claim with the record; clears it if inactive)
+ *
+ * Authentication: Application Default Credentials only (`gcloud auth application-default login`). Key files inside this
+ * repository are refused, and the old project is hard-refused. Nothing is hardcoded.
+ */
+const path = require("path")
+const readline = require("readline")
+const admin = require("firebase-admin")
+const lib = require("../src/lib/bootstrap")
+
+const args = process.argv.slice(2)
+const command = args[0]
+const flag = (n) => { const i = args.indexOf(`--${n}`); return i > -1 && args[i + 1] && !args[i + 1].startsWith("--") ? args[i + 1] : undefined }
+const has = (n) => args.includes(`--${n}`)
+const die = (m) => { console.error(`\nERROR: ${m}\n`); process.exit(1) }
+
+const projectId = flag("project") || "xploresoweto"
+if (projectId === lib.OLD_PROJECT) die(`Refusing to run against the old project "${lib.OLD_PROJECT}".`)
+const key = process.env.GOOGLE_APPLICATION_CREDENTIALS
+if (key && path.resolve(key).startsWith(path.resolve(__dirname, "..", "..") + path.sep)) die("GOOGLE_APPLICATION_CREDENTIALS points inside this repository. Keep service-account keys outside the repo (or use ADC).")
+admin.initializeApp({ projectId })
+console.log(`Target: ${process.env.FIRESTORE_EMULATOR_HOST ? `EMULATOR ${process.env.FIRESTORE_EMULATOR_HOST}` : `LIVE project "${projectId}"`}`)
+
+const ask = (q) => new Promise((res) => { const rl = readline.createInterface({ input: process.stdin, output: process.stdout }); rl.question(q, (a) => { rl.close(); res(a.trim()) }) })
+
+;(async () => {
+  if (command === "status") {
+    const rows = await lib.status()
+    if (!rows.length) return console.log("No super-admin records exist yet. Create the first one manually in the console.")
+    rows.forEach((r) => console.log(`${r.uid}  ${r.email}  active=${r.active}  claim=${r.claim}${r.problems.length ? "\n    ! " + r.problems.join("\n    ! ") : ""}`))
+  } else if (command === "bootstrap") {
+    const typed = flag("confirm-email")
+    const r = await lib.bootstrap({
+      uid: flag("uid"), allowMultiple: has("allow-multiple"),
+      confirm: async (user) => {
+        console.log(`\nAccount: ${user.email}  |  ${user.displayName || "-"}  |  created ${user.metadata.creationTime}  |  emailVerified=${user.emailVerified}`)
+        const answer = typed ?? (await ask(`Type the email "${user.email}" to ACTIVATE super-admin claim: `))
+        return answer.toLowerCase() === String(user.email).toLowerCase()
+      },
+    })
+    console.log("\nResult:", r)
+    if (!r.emailVerified) console.log("\nNOTE: this email is NOT verified. The account's admin powers stay inert until it verifies its email (functions and rules require it).")
+    console.log("The user must sign out and sign in again (or refresh the ID token) to receive the claim.")
+  } else if (command === "sync") {
+    if (!flag("uid")) die("--uid is required")
+    console.log(await lib.syncOne(flag("uid")))
+  } else die("Usage: super-admin.js <status|bootstrap|sync> [--uid UID]")
+})().catch((e) => die(e.bootstrap ? e.message : e.stack || e.message))
diff --git a/functions/src/handlers/applications.js b/functions/src/handlers/applications.js
new file mode 100644
index 0000000..36f8061
--- /dev/null
+++ b/functions/src/handlers/applications.js
@@ -0,0 +1,95 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const fb = require("../lib/firebase")
+const { COL, ORG_TYPES, LIMITS } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const { writeAudit } = require("../lib/audit")
+const { permissionsForRole } = require("../lib/org")
+
+async function submitProviderApplication(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["requestId", "organisationType", "organisationName", "description", "contact", "documentPaths"])
+  const rid = V.requestId(d.requestId)
+  const type = V.oneOf(d.organisationType, "organisationType", ORG_TYPES)
+  const name = V.str(d.organisationName, "organisationName", { min: 2, max: 120 })
+  const description = V.optStr(d.description, "description", { max: 2000 }) || ""
+  const c = V.object(d.contact, "contact")
+  V.onlyKeys(c, ["phone", "email", "address", "website"], "contact")
+  const contact = {}
+  if (c.phone !== undefined) contact.phone = V.optPhone(c.phone, "contact.phone")
+  if (c.email !== undefined) contact.email = V.email(c.email, "contact.email")
+  if (c.address !== undefined) contact.address = V.optStr(c.address, "contact.address", { max: 300 })
+  if (c.website !== undefined) contact.website = V.optStr(c.website, "contact.website", { max: 200 })
+  Object.keys(contact).forEach((k) => contact[k] === undefined && delete contact[k])
+  const documentPaths = V.storagePaths(d.documentPaths, "documentPaths", `provider-applications/${ctx.uid}/`, LIMITS.MAX_DOCUMENT_PATHS)
+
+  const applicationId = `${ctx.uid}_${rid}`
+  const ref = fb.db().collection(COL.applications).doc(applicationId)
+  const FV = fb.FieldValue()
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    if (snap.exists) return { applicationId, status: snap.data().status, duplicate: true } // safe retry
+    const open = await tx.get(fb.db().collection(COL.applications).where("applicantUid", "==", ctx.uid).where("status", "==", "submitted"))
+    if (open.size >= LIMITS.MAX_OPEN_APPLICATIONS) throw new HttpsError("resource-exhausted", "too-many-open-applications")
+    tx.set(ref, {
+      applicantUid: ctx.uid, organisationType: type, organisationName: name, description, contact, documentPaths,
+      status: "submitted", createdAt: FV.serverTimestamp(), updatedAt: FV.serverTimestamp(),
+    })
+    return { applicationId, status: "submitted", duplicate: false }
+  })
+}
+
+async function reviewProviderApplication(request) {
+  const actor = await G.requireActiveSuperAdmin(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["applicationId", "decision", "note"])
+  const applicationId = V.docId(d.applicationId, "applicationId")
+  const decision = V.oneOf(d.decision, "decision", ["approve", "reject"])
+  const note = V.optStr(d.note, "note", { max: 1000 }) || null
+
+  const appRef = fb.db().collection(COL.applications).doc(applicationId)
+  const pre = await appRef.get()
+  if (!pre.exists) throw new HttpsError("not-found", "Application not found")
+  const applicantUid = pre.data().applicantUid
+  if (applicantUid === actor.uid) throw new HttpsError("permission-denied", "cannot-review-own-application")
+  if (decision === "approve") {
+    try { await fb.auth().getUser(applicantUid) } catch { throw new HttpsError("failed-precondition", "applicant-account-missing") }
+  }
+
+  const FV = fb.FieldValue()
+  const orgRef = fb.db().collection(COL.orgs).doc(applicationId) // deterministic: one application -> at most one organisation
+  const memRef = fb.db().collection(COL.members).doc(`${applicationId}_${applicantUid}`)
+  const userRef = fb.db().collection(COL.users).doc(applicantUid)
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(appRef)
+    const app = snap.data()
+    if (decision === "approve" && app.status === "approved") return { status: "approved", organisationId: app.organisationId, duplicate: true }
+    if (decision === "reject" && app.status === "rejected") return { status: "rejected", duplicate: true }
+    if (app.status !== "submitted") throw new HttpsError("failed-precondition", `application-${app.status}`)
+    if (!ORG_TYPES.includes(app.organisationType)) throw new HttpsError("failed-precondition", "invalid-organisation-type")
+
+    if (decision === "reject") {
+      tx.update(appRef, { status: "rejected", reviewedBy: actor.uid, reviewedAt: FV.serverTimestamp(), reviewNote: note, updatedAt: FV.serverTimestamp() })
+      writeAudit(tx, { action: "provider.reject", actorUid: actor.uid, targetUid: applicantUid, details: { applicationId } })
+      return { status: "rejected", duplicate: false }
+    }
+    const [orgSnap, userSnap] = await Promise.all([tx.get(orgRef), tx.get(userRef)])
+    if (orgSnap.exists) throw new HttpsError("already-exists", "organisation-exists")
+    const displayName = userSnap.exists ? userSnap.data().displayName || null : null
+    const now = FV.serverTimestamp()
+    tx.set(orgRef, {
+      name: app.organisationName, organisationType: app.organisationType, description: app.description || "", ownerUid: applicantUid,
+      verificationStatus: "verified", approvalStatus: "approved", active: true, contact: app.contact || {}, applicationId, createdAt: now, updatedAt: now,
+    })
+    tx.set(memRef, {
+      organisationId: applicationId, userId: applicantUid, displayName, role: "owner", permissions: permissionsForRole("owner"),
+      active: true, status: "active", invitedBy: null, createdAt: now, updatedAt: now,
+    })
+    tx.update(appRef, { status: "approved", organisationId: applicationId, reviewedBy: actor.uid, reviewedAt: now, reviewNote: note, updatedAt: now })
+    writeAudit(tx, { action: "provider.approve", actorUid: actor.uid, targetUid: applicantUid, organisationId: applicationId, details: { applicationId, organisationType: app.organisationType } })
+    return { status: "approved", organisationId: applicationId, duplicate: false }
+  })
+}
+module.exports = { submitProviderApplication, reviewProviderApplication }
diff --git a/functions/src/handlers/invitations.js b/functions/src/handlers/invitations.js
new file mode 100644
index 0000000..3da1a9f
--- /dev/null
+++ b/functions/src/handlers/invitations.js
@@ -0,0 +1,175 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const fb = require("../lib/firebase")
+const { COL, ORG_ROLES, MANAGER_ASSIGNABLE_ROLES, LIMITS } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const clock = require("../lib/clock")
+const { writeAudit } = require("../lib/audit")
+const { sha256hex, newToken, safeEqualHex } = require("../lib/crypto")
+const { permissionsForRole, isExpired } = require("../lib/org")
+
+// Invitation document ids are a hash of (organisation, email): no email appears in any path, and clients cannot read
+// this collection at all (rules deny it); they go through these functions, which mask emails.
+const invitationId = (orgId, email) => sha256hex(`${orgId}|${email}`)
+const invCol = () => fb.db().collection(COL.invitations)
+const notFound = () => new HttpsError("not-found", "invalid-invitation") // identical for missing / wrong email / wrong token
+
+async function inviteOrganisationMember(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["organisationId", "email", "role"])
+  const orgId = V.docId(d.organisationId, "organisationId")
+  const inviteEmail = V.email(d.email)
+  const role = V.oneOf(d.role, "role", ORG_ROLES)
+  if (inviteEmail === ctx.email) throw V.bad("You cannot invite yourself")
+
+  let existingUid = null
+  try { existingUid = (await fb.auth().getUserByEmail(inviteEmail)).uid } catch (e) { if (!e || e.code !== "auth/user-not-found") throw e }
+
+  const id = invitationId(orgId, inviteEmail)
+  const ref = invCol().doc(id)
+  const token = newToken()
+  const FV = fb.FieldValue()
+  const expires = fb.Timestamp().fromMillis(clock.now().getTime() + LIMITS.INVITE_TTL_DAYS * 86400000)
+
+  await fb.db().runTransaction(async (tx) => {
+    const { org, membership } = await G.requireOrgPermission(tx, ctx.uid, orgId, "members.manage")
+    if (membership.role !== "owner" && !MANAGER_ASSIGNABLE_ROLES.includes(role)) throw new HttpsError("permission-denied", "role-not-assignable")
+    if (existingUid) {
+      const m = await tx.get(G.memberRef(orgId, existingUid))
+      if (m.exists && m.data().active === true) throw new HttpsError("already-exists", "already-member")
+    }
+    const snap = await tx.get(ref)
+    const pendingNow = snap.exists && snap.data().status === "pending"
+    if (!pendingNow) {
+      const q = await tx.get(invCol().where("organisationId", "==", orgId).where("status", "==", "pending"))
+      if (q.docs.filter((s) => !isExpired(s.data().expiresAt)).length >= LIMITS.MAX_PENDING_INVITES_PER_ORG) throw new HttpsError("resource-exhausted", "too-many-pending-invitations")
+    }
+    const base = {
+      organisationId: orgId, organisationName: org.name, email: inviteEmail, role, permissions: permissionsForRole(role),
+      tokenHash: sha256hex(token), status: "pending", expiresAt: expires, invitedBy: ctx.uid, updatedAt: FV.serverTimestamp(),
+    }
+    tx.set(ref, { ...base, createdAt: snap.exists ? snap.data().createdAt : FV.serverTimestamp() }) // re-inviting refreshes token + expiry
+    writeAudit(tx, { action: "organisation.invitation.create", actorUid: ctx.uid, organisationId: orgId, details: { role, invitationId: id } })
+  })
+  // The raw token is returned ONCE to the inviter; only its SHA-256 hash is stored.
+  return { invitationId: id, token, expiresAt: expires.toMillis() }
+}
+
+async function listOrganisationInvitations(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["organisationId"])
+  const orgId = V.docId(d.organisationId, "organisationId")
+  await G.requireOrgPermission(G.direct, ctx.uid, orgId, "members.manage")
+  const snap = await invCol().where("organisationId", "==", orgId).get()
+  const invitations = snap.docs.slice(0, 200).map((s) => {
+    const x = s.data()
+    const status = x.status === "pending" && isExpired(x.expiresAt) ? "expired" : x.status
+    return { invitationId: s.id, email: V.maskEmail(x.email), role: x.role, status, expiresAt: x.expiresAt.toMillis() }
+  })
+  return { invitations }
+}
+
+async function revokeOrganisationInvitation(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["organisationId", "invitationId"])
+  const orgId = V.docId(d.organisationId, "organisationId")
+  const ref = invCol().doc(V.docId(d.invitationId, "invitationId"))
+  const FV = fb.FieldValue()
+  const changed = await fb.db().runTransaction(async (tx) => {
+    const { membership } = await G.requireOrgPermission(tx, ctx.uid, orgId, "members.manage")
+    const snap = await tx.get(ref)
+    if (!snap.exists || snap.data().organisationId !== orgId) throw new HttpsError("not-found", "invitation-not-found")
+    const inv = snap.data()
+    if (membership.role !== "owner" && !MANAGER_ASSIGNABLE_ROLES.includes(inv.role)) throw new HttpsError("permission-denied", "role-not-assignable")
+    if (inv.status === "revoked") return false
+    if (inv.status !== "pending") throw new HttpsError("failed-precondition", `invitation-${inv.status}`)
+    tx.update(ref, { status: "revoked", revokedBy: ctx.uid, revokedAt: FV.serverTimestamp(), updatedAt: FV.serverTimestamp() })
+    writeAudit(tx, { action: "organisation.invitation.revoke", actorUid: ctx.uid, organisationId: orgId, details: { role: inv.role, invitationId: ref.id } })
+    return true
+  })
+  return { ok: true, changed }
+}
+
+async function listMyInvitations(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const snap = await invCol().where("email", "==", ctx.email).where("status", "==", "pending").get()
+  const invitations = snap.docs.filter((s) => !isExpired(s.data().expiresAt)).map((s) => {
+    const x = s.data()
+    return { invitationId: s.id, organisationId: x.organisationId, organisationName: x.organisationName, role: x.role, expiresAt: x.expiresAt.toMillis() }
+  })
+  return { invitations }
+}
+
+// Acceptance requires a VERIFIED email that equals the invited email. Authorisation is either the invitationId shown in-app to
+// that email's owner, or the single-use token. The membership is created here, never by the client.
+async function acceptOrganisationInvitation(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["invitationId", "token"])
+  if (d.invitationId === undefined && d.token === undefined) throw V.bad("invitationId or token is required")
+  let ref
+  let token
+  if (d.token !== undefined) {
+    token = V.str(d.token, "token", { min: 20, max: 100 })
+    const q = await invCol().where("tokenHash", "==", sha256hex(token)).limit(1).get()
+    if (q.empty) throw notFound()
+    ref = q.docs[0].ref
+    if (d.invitationId !== undefined && V.docId(d.invitationId, "invitationId") !== ref.id) throw notFound()
+  } else {
+    ref = invCol().doc(V.docId(d.invitationId, "invitationId"))
+  }
+  const FV = fb.FieldValue()
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    if (!snap.exists) throw notFound()
+    const inv = snap.data()
+    if (inv.email !== ctx.email) throw notFound()
+    if (token !== undefined && !safeEqualHex(sha256hex(token), inv.tokenHash)) throw notFound()
+    const mRef = G.memberRef(inv.organisationId, ctx.uid)
+    const [mSnap, oSnap, uSnap] = await Promise.all([tx.get(mRef), tx.get(G.orgRef(inv.organisationId)), tx.get(fb.db().collection(COL.users).doc(ctx.uid))])
+    if (inv.status === "accepted") {
+      if (mSnap.exists && mSnap.data().active === true && mSnap.data().invitationId === ref.id) return { alreadyMember: true, organisationId: inv.organisationId } // safe retry
+      throw new HttpsError("failed-precondition", "invitation-used")
+    }
+    if (inv.status !== "pending") throw new HttpsError("failed-precondition", `invitation-${inv.status}`)
+    if (isExpired(inv.expiresAt)) throw new HttpsError("failed-precondition", "invitation-expired")
+    if (!oSnap.exists || oSnap.data().approvalStatus !== "approved" || oSnap.data().active !== true) throw new HttpsError("failed-precondition", "organisation-inactive")
+    const now = FV.serverTimestamp()
+    if (mSnap.exists && mSnap.data().active === true) { // already a member through another path: consume the invitation, change nothing else
+      tx.update(ref, { status: "accepted", acceptedBy: ctx.uid, acceptedAt: now, updatedAt: now })
+      return { alreadyMember: true, organisationId: inv.organisationId }
+    }
+    const base = {
+      organisationId: inv.organisationId, userId: ctx.uid, displayName: uSnap.exists ? uSnap.data().displayName || null : null,
+      role: inv.role, permissions: permissionsForRole(inv.role), active: true, status: "active", invitedBy: inv.invitedBy, invitationId: ref.id, updatedAt: now,
+    }
+    if (mSnap.exists) tx.update(mRef, { ...base, removedBy: FV.delete(), removedAt: FV.delete() })
+    else tx.set(mRef, { ...base, createdAt: now })
+    tx.update(ref, { status: "accepted", acceptedBy: ctx.uid, acceptedAt: now, updatedAt: now })
+    writeAudit(tx, { action: "organisation.member.add", actorUid: ctx.uid, targetUid: ctx.uid, organisationId: inv.organisationId, details: { role: inv.role, invitationId: ref.id } })
+    return { alreadyMember: false, organisationId: inv.organisationId, role: inv.role }
+  })
+}
+
+async function declineOrganisationInvitation(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["invitationId"])
+  const ref = invCol().doc(V.docId(d.invitationId, "invitationId"))
+  const FV = fb.FieldValue()
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    if (!snap.exists || snap.data().email !== ctx.email) throw notFound()
+    const inv = snap.data()
+    if (inv.status === "declined") return { ok: true, changed: false }
+    if (inv.status !== "pending") throw new HttpsError("failed-precondition", `invitation-${inv.status}`)
+    tx.update(ref, { status: "declined", declinedAt: FV.serverTimestamp(), updatedAt: FV.serverTimestamp() })
+    writeAudit(tx, { action: "organisation.invitation.decline", actorUid: ctx.uid, organisationId: inv.organisationId, details: { invitationId: ref.id } })
+    return { ok: true, changed: true }
+  })
+}
+module.exports = { inviteOrganisationMember, listOrganisationInvitations, revokeOrganisationInvitation, listMyInvitations, acceptOrganisationInvitation, declineOrganisationInvitation, invitationId }
diff --git a/functions/src/handlers/listings.js b/functions/src/handlers/listings.js
new file mode 100644
index 0000000..96257d2
--- /dev/null
+++ b/functions/src/handlers/listings.js
@@ -0,0 +1,116 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const fb = require("../lib/firebase")
+const { COL, LISTING_TARGETS, LIMITS } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const { writeAudit } = require("../lib/audit")
+
+const TEXT_FIELDS = { name: 120, type: 60, category: 60, description: 2000, location: 300, address: 300, phone: 20, email: 254, website: 200, openingHours: 300, hours: 300, price: 60, priceRange: 60, cuisine: 100 }
+const LIST_FIELDS = ["tags", "features", "amenities", "specialDishes"]
+const ALLOWED_PAYLOAD = [...Object.keys(TEXT_FIELDS), ...LIST_FIELDS, "coordinates"]
+
+function validatePayload(p) {
+  const o = V.object(p, "payload")
+  V.onlyKeys(o, ALLOWED_PAYLOAD, "payload")
+  const out = {}
+  for (const [k, max] of Object.entries(TEXT_FIELDS)) if (o[k] !== undefined) out[k] = V.str(o[k], k, { min: 1, max })
+  for (const k of LIST_FIELDS) {
+    if (o[k] === undefined) continue
+    if (!Array.isArray(o[k]) || o[k].length > 30) throw V.bad(`${k} must be a short list`)
+    out[k] = o[k].map((x) => V.str(x, k, { max: 100 }))
+  }
+  if (o.coordinates !== undefined) {
+    const c = V.object(o.coordinates, "coordinates")
+    V.onlyKeys(c, ["latitude", "longitude"], "coordinates")
+    if (typeof c.latitude !== "number" || typeof c.longitude !== "number" || Math.abs(c.latitude) > 90 || Math.abs(c.longitude) > 180) throw V.bad("Invalid coordinates")
+    out.coordinates = { latitude: c.latitude, longitude: c.longitude }
+  }
+  return out
+}
+
+async function submitListing(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["requestId", "organisationId", "kind", "targetDocId", "payload", "imagePaths"])
+  const rid = V.requestId(d.requestId)
+  const orgId = V.docId(d.organisationId, "organisationId")
+  const kind = V.oneOf(d.kind, "kind", ["new", "change"])
+  const targetDocId = kind === "change" ? V.docId(d.targetDocId, "targetDocId") : null
+  const payload = validatePayload(d.payload)
+  if (kind === "new" && !payload.name) throw V.bad("A new listing needs a name")
+  const submissionId = `${orgId}_${rid}`
+  const imagePaths = V.storagePaths(d.imagePaths, "imagePaths", `listing-submissions/${orgId}/${submissionId}/`, LIMITS.MAX_IMAGE_PATHS)
+  const ref = fb.db().collection(COL.submissions).doc(submissionId)
+  const FV = fb.FieldValue()
+  return fb.db().runTransaction(async (tx) => {
+    const { org } = await G.requireOrgPermission(tx, ctx.uid, orgId, "content.manage")
+    const targetCollection = LISTING_TARGETS[org.organisationType]
+    if (!targetCollection) throw new HttpsError("failed-precondition", "listing-type-not-supported-yet") // tour packages are a later stage
+    const snap = await tx.get(ref)
+    if (snap.exists) return { submissionId, status: snap.data().status, duplicate: true }
+    const pending = await tx.get(fb.db().collection(COL.submissions).where("organisationId", "==", orgId).where("status", "==", "pending"))
+    if (pending.size >= LIMITS.MAX_PENDING_SUBMISSIONS_PER_ORG) throw new HttpsError("resource-exhausted", "too-many-pending-submissions")
+    tx.set(ref, { organisationId: orgId, kind, targetCollection, targetDocId, payload, imagePaths, status: "pending", submittedBy: ctx.uid, createdAt: FV.serverTimestamp(), updatedAt: FV.serverTimestamp() })
+    return { submissionId, status: "pending", duplicate: false }
+  })
+}
+
+// Staff (active super admin or editor) approve or reject. Approval publishes into the existing public collection with
+// organisationId + isActive:true, which is what makes the listing visible to the app's (isActive-filtered) queries.
+async function reviewListingSubmission(request) {
+  const staff = await G.requireActiveStaff(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["submissionId", "decision", "note"])
+  const id = V.docId(d.submissionId, "submissionId")
+  const decision = V.oneOf(d.decision, "decision", ["approve", "reject"])
+  const note = V.optStr(d.note, "note", { max: 1000 }) || null
+  const ref = fb.db().collection(COL.submissions).doc(id)
+  const pre = await ref.get()
+  if (!pre.exists) throw new HttpsError("not-found", "submission-not-found")
+  const FV = fb.FieldValue()
+
+  let imageUrls = []
+  if (decision === "approve" && pre.data().status === "pending") {
+    const s = pre.data()
+    const bucket = fb.bucket()
+    const docId = s.kind === "new" ? id : s.targetDocId
+    // Copy submitted images to the public folder (idempotent: deterministic destinations). The public URL needs no token because
+    // public folders are world-readable under the Storage rules.
+    for (const p of s.imagePaths || []) {
+      const dest = `${s.targetCollection}/${s.organisationId}/${docId}/${p.split("/").pop()}`
+      await bucket.file(p).copy(bucket.file(dest))
+      imageUrls.push(`https://firebasestorage.googleapis.com/v0/b/${bucket.name}/o/${encodeURIComponent(dest)}?alt=media`)
+    }
+  }
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    const s = snap.data()
+    if (decision === "approve" && s.status === "approved") return { status: "approved", publishedDocId: s.publishedDocId, duplicate: true }
+    if (decision === "reject" && s.status === "rejected") return { status: "rejected", duplicate: true }
+    if (s.status !== "pending") throw new HttpsError("failed-precondition", `submission-${s.status}`)
+    if (decision === "reject") {
+      tx.update(ref, { status: "rejected", reviewedBy: staff.uid, reviewedAt: FV.serverTimestamp(), reviewNote: note, updatedAt: FV.serverTimestamp() })
+      writeAudit(tx, { action: "listing.reject", actorUid: staff.uid, organisationId: s.organisationId, details: { submissionId: id } })
+      return { status: "rejected", duplicate: false }
+    }
+    const docId = s.kind === "new" ? id : s.targetDocId
+    const targetRef = fb.db().collection(s.targetCollection).doc(docId)
+    const [tSnap, oSnap] = await Promise.all([tx.get(targetRef), tx.get(G.orgRef(s.organisationId))])
+    if (!oSnap.exists || oSnap.data().approvalStatus !== "approved" || oSnap.data().active !== true) throw new HttpsError("failed-precondition", "organisation-inactive")
+    const now = FV.serverTimestamp()
+    if (s.kind === "new") {
+      if (tSnap.exists) throw new HttpsError("already-exists", "listing-exists")
+      tx.set(targetRef, { ...s.payload, images: imageUrls, organisationId: s.organisationId, isActive: true, submissionId: id, publishedBy: staff.uid, createdAt: now, updatedAt: now })
+    } else {
+      if (!tSnap.exists || tSnap.data().organisationId !== s.organisationId) throw new HttpsError("failed-precondition", "target-not-owned-by-organisation")
+      const patch = { ...s.payload, updatedAt: now }
+      if (imageUrls.length) patch.images = imageUrls
+      tx.update(targetRef, patch)
+    }
+    tx.update(ref, { status: "approved", publishedDocId: docId, reviewedBy: staff.uid, reviewedAt: now, reviewNote: note, updatedAt: now })
+    writeAudit(tx, { action: "listing.publish", actorUid: staff.uid, organisationId: s.organisationId, details: { submissionId: id, targetCollection: s.targetCollection, docId } })
+    return { status: "approved", publishedDocId: docId, duplicate: false }
+  })
+}
+module.exports = { submitListing, reviewListingSubmission }
diff --git a/functions/src/handlers/loadshedding.js b/functions/src/handlers/loadshedding.js
new file mode 100644
index 0000000..5fbca01
--- /dev/null
+++ b/functions/src/handlers/loadshedding.js
@@ -0,0 +1,63 @@
+"use strict"
+const fb = require("../lib/firebase")
+const { COL, LIMITS } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const { writeAudit } = require("../lib/audit")
+
+const DAYS = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
+const RANGE = /^\d{2}:\d{2} - \d{2}:\d{2}$/
+
+function validateItem(item, i) {
+  const o = V.object(item, `schedules[${i}]`)
+  V.onlyKeys(o, ["suburb", "schedule"], `schedules[${i}]`)
+  const suburb = V.str(o.suburb, "suburb", { max: 80 })
+  const schedule = V.object(o.schedule, "schedule")
+  const out = {}
+  for (const [stage, days] of Object.entries(schedule)) {
+    if (!/^stage_[1-8]$/.test(stage)) throw V.bad(`Invalid stage "${stage}"`)
+    const dd = V.object(days, stage)
+    out[stage] = {}
+    for (const [day, ranges] of Object.entries(dd)) {
+      if (!DAYS.includes(day)) throw V.bad(`Invalid day "${day}"`)
+      if (!Array.isArray(ranges) || ranges.length > 12 || !ranges.every((r) => typeof r === "string" && RANGE.test(r))) throw V.bad(`Invalid times for ${stage}/${day}`)
+      out[stage][day] = ranges
+    }
+  }
+  const id = suburb.toLowerCase().replace(/[\/\\]/g, "-")
+  if (id === "." || id === ".." || /^__.*__$/.test(id)) throw V.bad("Invalid suburb")
+  return { id, suburb, schedule: out }
+}
+
+// Super-admin-only. The caller supplies the APPROVED data; nothing is bundled or auto-seeded.
+// Existing suburbs are skipped unless overwrite:true AND confirmOverwrite:"OVERWRITE". Re-running is safe.
+async function seedLoadshedding(request) {
+  const actor = await G.requireActiveSuperAdmin(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["schedules", "overwrite", "confirmOverwrite"])
+  if (!Array.isArray(d.schedules) || d.schedules.length === 0 || d.schedules.length > LIMITS.LOADSHEDDING_MAX_DOCS) throw V.bad("schedules must be a non-empty list")
+  const overwrite = d.overwrite === true
+  if (overwrite && d.confirmOverwrite !== "OVERWRITE") throw V.bad('Overwriting requires confirmOverwrite: "OVERWRITE"')
+  const items = d.schedules.map(validateItem)
+  if (new Set(items.map((i) => i.id)).size !== items.length) throw V.bad("Duplicate suburbs in request")
+
+  const col = fb.db().collection(COL.loadshedding)
+  const FV = fb.FieldValue()
+  const existing = new Set()
+  for (let i = 0; i < items.length; i += 50) {
+    const snaps = await Promise.all(items.slice(i, i + 50).map((it) => col.doc(it.id).get()))
+    snaps.forEach((s, k) => { if (s.exists) existing.add(items[i + k].id) })
+  }
+  const toWrite = items.filter((it) => overwrite || !existing.has(it.id))
+  const skipped = items.length - toWrite.length
+  const overwritten = toWrite.filter((it) => existing.has(it.id)).length
+  for (let i = 0; i < toWrite.length; i += 400) {
+    const batch = fb.db().batch()
+    toWrite.slice(i, i + 400).forEach((it) => batch.set(col.doc(it.id), { suburb: it.suburb, schedule: it.schedule, isActive: true, seededBy: actor.uid, createdAt: FV.serverTimestamp(), updatedAt: FV.serverTimestamp() }))
+    if (i + 400 >= toWrite.length) writeAudit(batch, { action: "loadshedding.seed", actorUid: actor.uid, details: { created: toWrite.length - overwritten, overwritten, skipped } })
+    await batch.commit()
+  }
+  if (toWrite.length === 0) return { ok: true, created: 0, overwritten: 0, skipped }
+  return { ok: true, created: toWrite.length - overwritten, overwritten, skipped }
+}
+module.exports = { seedLoadshedding }
diff --git a/functions/src/handlers/members.js b/functions/src/handlers/members.js
new file mode 100644
index 0000000..9619a92
--- /dev/null
+++ b/functions/src/handlers/members.js
@@ -0,0 +1,71 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const fb = require("../lib/firebase")
+const { COL, ORG_ROLES, MANAGER_ASSIGNABLE_ROLES } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const { writeAudit } = require("../lib/audit")
+const { permissionsForRole } = require("../lib/org")
+
+const activeOwners = (tx, orgId) =>
+  tx.get(fb.db().collection(COL.members).where("organisationId", "==", orgId).where("role", "==", "owner").where("active", "==", true))
+
+// Role changes. Owners may set any role; everyone else may only touch staff-level roles, never their own, and never create
+// owners/managers. The last owner can never be demoted. All permission sets are resolved server-side.
+async function setMemberRole(request) {
+  const ctx = await G.requireAuth(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["organisationId", "userId", "role"])
+  const orgId = V.docId(d.organisationId, "organisationId")
+  const userId = V.docId(d.userId, "userId")
+  const role = V.oneOf(d.role, "role", ORG_ROLES)
+  const FV = fb.FieldValue()
+  const changed = await fb.db().runTransaction(async (tx) => {
+    const { membership: actor } = await G.requireOrgPermission(tx, ctx.uid, orgId, "members.manage")
+    if (userId === ctx.uid) throw new HttpsError("failed-precondition", "cannot-change-own-role")
+    const tSnap = await tx.get(G.memberRef(orgId, userId))
+    if (!tSnap.exists || tSnap.data().active !== true) throw new HttpsError("not-found", "member-not-found")
+    const target = tSnap.data()
+    if (actor.role !== "owner" && (!MANAGER_ASSIGNABLE_ROLES.includes(target.role) || !MANAGER_ASSIGNABLE_ROLES.includes(role))) throw new HttpsError("permission-denied", "role-not-assignable")
+    if (target.role === role) return false
+    if (target.role === "owner") {
+      const owners = await activeOwners(tx, orgId)
+      if (owners.size <= 1) throw new HttpsError("failed-precondition", "last-owner")
+    }
+    tx.update(tSnap.ref, { role, permissions: permissionsForRole(role), updatedAt: FV.serverTimestamp() })
+    writeAudit(tx, { action: "organisation.member.role", actorUid: ctx.uid, targetUid: userId, organisationId: orgId, details: { from: target.role, to: role } })
+    return true
+  })
+  return { ok: true, changed }
+}
+
+// Removal (or leaving: a member may always remove themselves unless they are the last owner).
+async function removeOrganisationMember(request) {
+  const ctx = await G.requireAuth(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["organisationId", "userId"])
+  const orgId = V.docId(d.organisationId, "organisationId")
+  const userId = V.docId(d.userId, "userId")
+  const FV = fb.FieldValue()
+  const changed = await fb.db().runTransaction(async (tx) => {
+    const self = userId === ctx.uid
+    let actor = null
+    if (!self) ({ membership: actor } = await G.requireOrgPermission(tx, ctx.uid, orgId, "members.manage"))
+    const tSnap = await tx.get(G.memberRef(orgId, userId))
+    if (!tSnap.exists || tSnap.data().active !== true) {
+      if (self) throw G.denied()
+      return false // already removed: idempotent
+    }
+    const target = tSnap.data()
+    if (!self && actor.role !== "owner" && !MANAGER_ASSIGNABLE_ROLES.includes(target.role)) throw new HttpsError("permission-denied", "role-not-assignable")
+    if (target.role === "owner") {
+      const owners = await activeOwners(tx, orgId)
+      if (owners.size <= 1) throw new HttpsError("failed-precondition", "last-owner")
+    }
+    tx.update(tSnap.ref, { active: false, status: "removed", removedBy: ctx.uid, removedAt: FV.serverTimestamp(), updatedAt: FV.serverTimestamp() })
+    writeAudit(tx, { action: "organisation.member.remove", actorUid: ctx.uid, targetUid: userId, organisationId: orgId, details: { role: target.role, self } })
+    return true
+  })
+  return { ok: true, changed }
+}
+module.exports = { setMemberRole, removeOrganisationMember }
diff --git a/functions/src/handlers/organisations.js b/functions/src/handlers/organisations.js
new file mode 100644
index 0000000..3da95df
--- /dev/null
+++ b/functions/src/handlers/organisations.js
@@ -0,0 +1,53 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const fb = require("../lib/firebase")
+const { COL } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const { writeAudit } = require("../lib/audit")
+
+const LISTING_COLLECTIONS = ["restaurants", "accommodations", "business"]
+
+// Hides (or restores) the organisation's published listings. Only listings hidden BY the suspension are restored, so a listing
+// that staff deactivated for another reason is never silently re-activated. Idempotent, safe to repeat.
+async function toggleListings(orgId, suspend) {
+  const FV = fb.FieldValue()
+  let updated = 0
+  for (const name of LISTING_COLLECTIONS) {
+    const snap = await fb.db().collection(name).where("organisationId", "==", orgId).get()
+    const docs = snap.docs.filter((s) => (suspend ? s.data().isActive === true : s.data().suspendedByOrganisation === true))
+    for (let i = 0; i < docs.length; i += 400) {
+      const batch = fb.db().batch()
+      docs.slice(i, i + 400).forEach((s) => batch.update(s.ref, suspend ? { isActive: false, suspendedByOrganisation: true } : { isActive: true, suspendedByOrganisation: FV.delete() }))
+      await batch.commit()
+    }
+    updated += docs.length
+  }
+  return updated
+}
+
+async function setOrganisationStatus(request) {
+  const actor = await G.requireActiveSuperAdmin(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["organisationId", "status", "reason"])
+  const orgId = V.docId(d.organisationId, "organisationId")
+  const status = V.oneOf(d.status, "status", ["approved", "suspended"])
+  const reason = V.optStr(d.reason, "reason", { max: 500 })
+  if (status === "suspended" && !reason) throw V.bad("A reason is required to suspend an organisation")
+  const ref = G.orgRef(orgId)
+  const FV = fb.FieldValue()
+  const changed = await fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    if (!snap.exists) throw new HttpsError("not-found", "Organisation not found")
+    if (snap.data().approvalStatus === status) return false
+    tx.update(ref, {
+      approvalStatus: status, active: status === "approved", updatedAt: FV.serverTimestamp(),
+      suspension: status === "suspended" ? { reason, by: actor.uid, at: FV.serverTimestamp() } : FV.delete(),
+    })
+    writeAudit(tx, { action: status === "suspended" ? "organisation.suspend" : "organisation.restore", actorUid: actor.uid, organisationId: orgId, details: { reason: reason || null } })
+    return true
+  })
+  const listingsUpdated = await toggleListings(orgId, status === "suspended") // also repairs an interrupted earlier attempt
+  return { ok: true, changed, listingsUpdated }
+}
+module.exports = { setOrganisationStatus }
diff --git a/functions/src/handlers/platform.js b/functions/src/handlers/platform.js
new file mode 100644
index 0000000..67679f0
--- /dev/null
+++ b/functions/src/handlers/platform.js
@@ -0,0 +1,58 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const fb = require("../lib/firebase")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const { writeAudit } = require("../lib/audit")
+const platform = require("../lib/platform")
+
+// Only an ACTIVE super admin (claim + verified email + active record) may change platform roles.
+// The first super admin is created manually in Firestore and activated with scripts/super-admin.js.
+async function managePlatformRole(request) {
+  const actor = await G.requireActiveSuperAdmin(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["action", "role", "uid"])
+  const action = V.oneOf(d.action, "action", ["add", "remove"])
+  const roleKey = V.oneOf(d.role, "role", ["superAdmin", "editor"])
+  const target = V.docId(d.uid, "uid")
+  const kind = platform.KINDS[roleKey]
+  const ref = fb.db().collection(kind.col).doc(target)
+  const FV = fb.FieldValue()
+  let changed
+
+  if (action === "add") {
+    let user
+    try { user = await fb.auth().getUser(target) } catch (e) {
+      if (e && e.code === "auth/user-not-found") throw new HttpsError("not-found", "No such account")
+      throw e
+    }
+    if (!user.email) throw new HttpsError("failed-precondition", "account-has-no-email")
+    if (!user.emailVerified) throw new HttpsError("failed-precondition", "target-email-not-verified")
+    changed = await fb.db().runTransaction(async (tx) => {
+      const snap = await tx.get(ref)
+      if (snap.exists && snap.data().active === true && snap.data().role === kind.role) return false
+      const base = { uid: target, email: user.email.toLowerCase(), displayName: user.displayName || null, role: kind.role, active: true, grantedBy: actor.uid, updatedAt: FV.serverTimestamp() }
+      if (snap.exists) tx.update(ref, { ...base, revokedBy: FV.delete() })
+      else tx.set(ref, { ...base, createdAt: FV.serverTimestamp() })
+      writeAudit(tx, { action: `platform.${roleKey}.add`, actorUid: actor.uid, targetUid: target })
+      return true
+    })
+  } else {
+    if (roleKey === "superAdmin" && target === actor.uid) throw new HttpsError("failed-precondition", "cannot-remove-self")
+    changed = await fb.db().runTransaction(async (tx) => {
+      const snap = await tx.get(ref)
+      if (!snap.exists || snap.data().active !== true) return false
+      if (roleKey === "superAdmin") {
+        const active = await tx.get(fb.db().collection(kind.col).where("active", "==", true))
+        if (active.size <= 1) throw new HttpsError("failed-precondition", "last-super-admin")
+      }
+      tx.update(ref, { active: false, revokedBy: actor.uid, updatedAt: FV.serverTimestamp() })
+      writeAudit(tx, { action: `platform.${roleKey}.remove`, actorUid: actor.uid, targetUid: target })
+      return true
+    })
+  }
+  // Always (re)align the derived claim with the authoritative record; this also repairs an interrupted earlier attempt.
+  const sync = await platform.syncClaim(roleKey, target)
+  return { ok: true, changed, claimChanged: sync.changed }
+}
+module.exports = { managePlatformRole }
diff --git a/functions/src/handlers/profile.js b/functions/src/handlers/profile.js
new file mode 100644
index 0000000..e505191
--- /dev/null
+++ b/functions/src/handlers/profile.js
@@ -0,0 +1,49 @@
+"use strict"
+const fb = require("../lib/firebase")
+const { COL } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+
+const FIELDS = ["displayName", "greeting", "kasi", "phone", "city"]
+const publicProfile = (p) => ({ uid: p.uid, displayName: p.displayName || null, greeting: p.greeting || null, kasi: p.kasi || null, enrolled: p.enrolled === true })
+
+// Creates users/{uid} if (and only if) it does not exist. Safe to call any number of times, from any device:
+// it never overwrites an existing profile and never accepts roles, permissions or verification status.
+async function ensureUserProfile(request) {
+  const ctx = await G.requireAuth(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, FIELDS)
+  const input = {
+    displayName: V.optStr(d.displayName, "displayName", { max: 60 }),
+    greeting: V.optStr(d.greeting, "greeting", { max: 60 }),
+    kasi: V.optStr(d.kasi, "kasi", { max: 60 }),
+    phone: V.optPhone(d.phone),
+    city: V.optStr(d.city, "city", { max: 60 }),
+  }
+  const ref = fb.db().collection(COL.users).doc(ctx.uid)
+  const FV = fb.FieldValue()
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    if (snap.exists) return { created: false, profile: publicProfile(snap.data()) }
+    const tokenName = typeof ctx.token.name === "string" ? ctx.token.name.trim().slice(0, 60) : ""
+    const displayName = input.displayName || tokenName || (ctx.email ? ctx.email.split("@")[0].slice(0, 60) : "Explorer")
+    const doc = {
+      uid: ctx.uid,
+      email: ctx.email,
+      displayName,
+      greeting: input.greeting ?? null,
+      kasi: input.kasi ?? null,
+      phone: input.phone ?? null,
+      city: input.city ?? null,
+      photoURL: null,
+      enrolled: false,
+      enrolledAt: null,
+      createdAt: FV.serverTimestamp(),
+      updatedAt: FV.serverTimestamp(),
+      schemaVersion: 1,
+    }
+    tx.set(ref, doc)
+    return { created: true, profile: publicProfile(doc) }
+  })
+}
+module.exports = { ensureUserProfile }
diff --git a/functions/src/handlers/requests.js b/functions/src/handlers/requests.js
new file mode 100644
index 0000000..f7524c5
--- /dev/null
+++ b/functions/src/handlers/requests.js
@@ -0,0 +1,106 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const fb = require("../lib/firebase")
+const { COL, BOOKABLE_COLLECTIONS, SERVICE_COLLECTIONS, LIMITS } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const clock = require("../lib/clock")
+
+const colFor = (kind) => (kind === "booking" ? COL.bookings : COL.serviceRequests)
+const notBookable = () => new HttpsError("failed-precondition", "listing-not-bookable")
+
+// Booking requests and service requests: the customer asks, the provider accepts or declines. Only listings that are active AND
+// linked to an active, approved organisation can receive requests; anything else gets a controlled "not available" error.
+async function createRequest(kind, request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  const rid = V.requestId(d.requestId)
+  const listingId = V.docId(d.listingId, "listingId")
+  let listingCollection, extra
+  if (kind === "booking") {
+    V.onlyKeys(d, ["requestId", "listingCollection", "listingId", "date", "endDate", "time", "guests", "notes", "phone"])
+    listingCollection = V.oneOf(d.listingCollection, "listingCollection", BOOKABLE_COLLECTIONS)
+    const date = V.ymd(d.date, "date")
+    if (date < clock.todaySAST()) throw V.bad("date-in-past")
+    const endDate = d.endDate === undefined ? undefined : V.ymd(d.endDate, "endDate")
+    if (endDate && endDate < date) throw V.bad("endDate must not be before date")
+    const time = d.time === undefined ? undefined : V.str(d.time, "time", { min: 5, max: 5 })
+    if (time && !/^([01]\d|2[0-3]):[0-5]\d$/.test(time)) throw V.bad("Invalid time")
+    extra = { date, endDate: endDate || null, time: time || null, guests: V.intRange(d.guests, "guests", 1, 50), notes: V.optStr(d.notes, "notes", { max: 500 }) || null, phone: V.optPhone(d.phone) || null }
+  } else {
+    V.onlyKeys(d, ["requestId", "listingCollection", "listingId", "message", "phone"])
+    listingCollection = V.oneOf(d.listingCollection ?? "business", "listingCollection", SERVICE_COLLECTIONS)
+    extra = { message: V.str(d.message, "message", { max: 1000 }), phone: V.optPhone(d.phone) || null }
+  }
+  const col = colFor(kind)
+  const id = `${ctx.uid}_${rid}`
+  const ref = fb.db().collection(col).doc(id)
+  const FV = fb.FieldValue()
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    if (snap.exists) return { id, status: snap.data().status, duplicate: true } // safe retry
+    const lSnap = await tx.get(fb.db().collection(listingCollection).doc(listingId))
+    const listing = lSnap.exists ? lSnap.data() : null
+    if (!listing || listing.isActive !== true || typeof listing.organisationId !== "string") throw notBookable()
+    const oSnap = await tx.get(G.orgRef(listing.organisationId))
+    if (!oSnap.exists || oSnap.data().approvalStatus !== "approved" || oSnap.data().active !== true) throw notBookable()
+    const pending = await tx.get(fb.db().collection(col).where("customerUid", "==", ctx.uid).where("status", "==", "pending"))
+    if (pending.size >= LIMITS.MAX_PENDING_REQUESTS_PER_USER) throw new HttpsError("resource-exhausted", "too-many-pending-requests")
+    const uSnap = await tx.get(fb.db().collection(COL.users).doc(ctx.uid))
+    tx.set(ref, {
+      customerUid: ctx.uid, customerName: uSnap.exists ? uSnap.data().displayName || null : null, customerEmail: ctx.email,
+      organisationId: listing.organisationId, listingCollection, listingId, listingName: listing.name || listing.title || "",
+      ...extra, status: "pending", createdAt: FV.serverTimestamp(), updatedAt: FV.serverTimestamp(),
+    })
+    return { id, status: "pending", duplicate: false }
+  })
+}
+const createBookingRequest = (request) => createRequest("booking", request)
+const createServiceRequest = (request) => createRequest("service", request)
+
+// State machine (both kinds):
+//   pending --accept/decline--> accepted/declined            (provider)
+//   accepted --complete--> completed_by_provider              (provider)
+//   completed_by_provider --confirmCompletion--> completed    (CUSTOMER)   <- only "completed" can unlock a review
+//   pending|accepted --cancel--> cancelled                    (customer)
+// A provider can therefore never unlock a review on its own: the customer has to confirm the service happened.
+const TRANSITIONS = {
+  accept: { from: ["pending"], to: "accepted", by: "provider" },
+  decline: { from: ["pending"], to: "declined", by: "provider" },
+  complete: { from: ["accepted"], to: "completed_by_provider", by: "provider" },
+  confirmCompletion: { from: ["completed_by_provider"], to: "completed", by: "customer" },
+  cancel: { from: ["pending", "accepted"], to: "cancelled", by: "customer" },
+}
+async function updateRequestStatus(request) {
+  const ctx = await G.requireAuth(request)
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["kind", "id", "action"])
+  const kind = V.oneOf(d.kind, "kind", ["booking", "service"])
+  const id = V.docId(d.id, "id")
+  const action = V.oneOf(d.action, "action", Object.keys(TRANSITIONS))
+  const t = TRANSITIONS[action]
+  const ref = fb.db().collection(colFor(kind)).doc(id)
+  const FV = fb.FieldValue()
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    if (!snap.exists) throw new HttpsError("not-found", "request-not-found")
+    const doc = snap.data()
+    if (t.by === "customer") {
+      if (doc.customerUid !== ctx.uid) throw new HttpsError("not-found", "request-not-found")
+    } else {
+      await G.requireOrgPermission(tx, ctx.uid, doc.organisationId, kind === "booking" ? "bookings.manage" : "enquiries.manage")
+    }
+    if (doc.status === t.to) return { id, status: doc.status, changed: false } // safe retry
+    if (!t.from.includes(doc.status)) throw new HttpsError("failed-precondition", "invalid-transition")
+    if (action === "complete" && kind === "booking" && (doc.endDate || doc.date) > clock.todaySAST()) throw new HttpsError("failed-precondition", "booking-date-not-reached")
+    const ts = FV.serverTimestamp()
+    const patch = { status: t.to, updatedAt: ts }
+    if (action === "accept" || action === "decline") Object.assign(patch, { respondedBy: ctx.uid, respondedAt: ts })
+    if (action === "complete") Object.assign(patch, { providerCompletedBy: ctx.uid, providerCompletedAt: ts })
+    if (action === "confirmCompletion") patch.customerConfirmedAt = ts
+    if (action === "cancel") patch.cancelledAt = ts
+    tx.update(ref, patch)
+    return { id, status: t.to, changed: true }
+  })
+}
+module.exports = { createBookingRequest, createServiceRequest, updateRequestStatus, TRANSITIONS }
diff --git a/functions/src/handlers/reviews.js b/functions/src/handlers/reviews.js
new file mode 100644
index 0000000..01dca53
--- /dev/null
+++ b/functions/src/handlers/reviews.js
@@ -0,0 +1,68 @@
+"use strict"
+const { HttpsError } = require("firebase-functions/v2/https")
+const fb = require("../lib/firebase")
+const { COL, BOOKABLE_COLLECTIONS, SERVICE_COLLECTIONS } = require("../lib/constants")
+const V = require("../lib/validate")
+const G = require("../lib/guards")
+const clock = require("../lib/clock")
+
+const ALL_REVIEWABLE = [...SERVICE_COLLECTIONS, ...BOOKABLE_COLLECTIONS]
+const basisCollection = (listingCollection) => (SERVICE_COLLECTIONS.includes(listingCollection) ? COL.serviceRequests : COL.bookings)
+const basisType = (listingCollection) => (SERVICE_COLLECTIONS.includes(listingCollection) ? "service-request" : "booking")
+
+// Eligibility is decided HERE from server-side records: the customer must hold a request for this listing that is "completed"
+// (provider marked it done AND the customer confirmed). Nothing client-controlled (such as a canReview flag) is consulted.
+async function findQualifying(reader, uid, listingCollection, listingId) {
+  const q = fb.db().collection(basisCollection(listingCollection))
+    .where("customerUid", "==", uid).where("listingId", "==", listingId).where("status", "==", "completed").limit(1)
+  const snap = await reader.get(q)
+  return snap.empty ? null : snap.docs[0]
+}
+const reviewId = (uid, listingCollection, listingId) => `${uid}_${listingCollection}_${listingId}`
+
+async function checkReviewEligibility(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["listingCollection", "listingId"])
+  const listingCollection = V.oneOf(d.listingCollection ?? "business", "listingCollection", ALL_REVIEWABLE)
+  const listingId = V.docId(d.listingId, "listingId")
+  const existing = await fb.db().collection(COL.reviews).doc(reviewId(ctx.uid, listingCollection, listingId)).get()
+  if (existing.exists) return { eligible: false, alreadyReviewed: true }
+  const basis = await findQualifying(G.direct, ctx.uid, listingCollection, listingId)
+  return { eligible: !!basis, alreadyReviewed: false }
+}
+
+async function submitReview(request) {
+  const ctx = G.requireVerified(await G.requireAuth(request))
+  const d = V.object(request.data)
+  V.onlyKeys(d, ["listingCollection", "listingId", "rating", "comment", "reviewerName"])
+  const listingCollection = V.oneOf(d.listingCollection ?? "business", "listingCollection", ALL_REVIEWABLE)
+  const listingId = V.docId(d.listingId, "listingId")
+  const rating = V.intRange(d.rating, "rating", 1, 5)
+  const comment = V.str(d.comment, "comment", { max: 1000 })
+  const reviewerName = V.optStr(d.reviewerName, "reviewerName", { max: 60 })
+  const id = reviewId(ctx.uid, listingCollection, listingId)
+  const ref = fb.db().collection(COL.reviews).doc(id)
+  const listingRef = fb.db().collection(listingCollection).doc(listingId)
+  const FV = fb.FieldValue()
+  return fb.db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref)
+    if (snap.exists) return { id, duplicate: true } // one review per customer per listing; retries are harmless
+    const basis = await findQualifying(tx, ctx.uid, listingCollection, listingId)
+    if (!basis) throw new HttpsError("failed-precondition", "not-eligible")
+    const [lSnap, uSnap] = await Promise.all([tx.get(listingRef), tx.get(fb.db().collection(COL.users).doc(ctx.uid))])
+    if (!lSnap.exists) throw new HttpsError("not-found", "listing-not-found")
+    const l = lSnap.data()
+    const count = (Number.isInteger(l.ratingCount) ? l.ratingCount : 0) + 1
+    const sum = (typeof l.ratingSum === "number" ? l.ratingSum : 0) + rating
+    // createdAt stays an ISO string because the existing review screen renders it with new Date(createdAt)
+    tx.set(ref, {
+      userId: ctx.uid, businessId: listingId, listingId, listingCollection, organisationId: l.organisationId || null, rating, comment,
+      reviewerName: reviewerName || (uSnap.exists ? uSnap.data().displayName : null) || "Explorer",
+      basis: { type: basisType(listingCollection), id: basis.id }, createdAt: clock.now().toISOString(), createdAtServer: FV.serverTimestamp(),
+    })
+    tx.update(listingRef, { ratingCount: count, ratingSum: sum, rating: Math.round((sum / count) * 10) / 10, reviews: count })
+    return { id, duplicate: false }
+  })
+}
+module.exports = { checkReviewEligibility, submitReview, reviewId }
diff --git a/functions/src/lib/audit.js b/functions/src/lib/audit.js
new file mode 100644
index 0000000..3407104
--- /dev/null
+++ b/functions/src/lib/audit.js
@@ -0,0 +1,15 @@
+"use strict"
+// Audit entries are written in the SAME transaction/batch as the change they describe, and only when state actually
+// changed (idempotent no-op retries return before reaching this), so retries never produce duplicate entries.
+// Entries hold uids, organisation ids and role names only (no personal data) and are server-write-only.
+const fb = require("./firebase")
+const { COL } = require("./constants")
+
+const clean = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined))
+function entry({ action, actorUid, targetUid = null, organisationId = null, details = {} }) {
+  return { action, actorUid, targetUid, organisationId, details: clean(details), at: fb.FieldValue().serverTimestamp() }
+}
+const ref = () => fb.db().collection(COL.audit).doc()
+module.exports = {
+  writeAudit: (writer, e) => writer.set(ref(), entry(e)), // writer: a transaction or a batch
+}
diff --git a/functions/src/lib/bootstrap.js b/functions/src/lib/bootstrap.js
new file mode 100644
index 0000000..3e36283
--- /dev/null
+++ b/functions/src/lib/bootstrap.js
@@ -0,0 +1,73 @@
+"use strict"
+// Logic behind scripts/super-admin.js, kept separate so it can be tested. It is deliberately READ-ONLY for the `super-admin`
+// collection: it never creates, edits or deletes a super-admin record. The first record is created by hand in the Firebase
+// console; this code only checks it and then derives the custom claim from it.
+const fb = require("./firebase")
+const { COL } = require("./constants")
+const platform = require("./platform")
+const { writeAudit } = require("./audit")
+
+const OLD_PROJECT = "the-steady-hotel"
+const fail = (m) => Object.assign(new Error(m), { bootstrap: true })
+
+async function loadAuthUser(uid) {
+  try { return await fb.auth().getUser(uid) } catch (e) {
+    if (e && e.code === "auth/user-not-found") throw fail(`No Firebase Authentication account has UID "${uid}".`)
+    throw e
+  }
+}
+async function checkRecord(uid, user) {
+  const snap = await fb.db().collection(COL.superAdmin).doc(uid).get()
+  if (!snap.exists) throw fail(`No document super-admin/${uid} exists. Create it manually in the Firebase console first (see docs/stage1/SUPER_ADMIN_BOOTSTRAP.md).`)
+  const r = snap.data()
+  if (r.uid !== uid) throw fail(`super-admin/${uid}: field "uid" is "${r.uid}" but must equal the document id.`)
+  if (r.role !== "super_admin") throw fail(`super-admin/${uid}: field "role" must be "super_admin" (found "${r.role}").`)
+  if (r.active !== true) throw fail(`super-admin/${uid}: field "active" must be true (found ${JSON.stringify(r.active)}).`)
+  if (typeof r.email !== "string" || r.email.toLowerCase() !== String(user.email || "").toLowerCase()) throw fail(`super-admin/${uid}: "email" does not match the Authentication account's email.`)
+  if (user.disabled) throw fail("The Authentication account is disabled.")
+  return r
+}
+async function otherActiveRecords(uid) {
+  const q = await fb.db().collection(COL.superAdmin).where("active", "==", true).get()
+  return q.docs.filter((d) => d.id !== uid).map((d) => d.id)
+}
+
+async function bootstrap({ uid, allowMultiple = false, confirm }) {
+  if (!uid) throw fail("--uid is required. This tool never chooses an account for you.")
+  const user = await loadAuthUser(uid)
+  const record = await checkRecord(uid, user)
+  const others = await otherActiveRecords(uid)
+  if (others.length && !allowMultiple) throw fail(`Other active super-admin records exist (${others.join(", ")}). Refusing without --allow-multiple.`)
+  if (confirm && !(await confirm(user))) throw fail("Not confirmed. Nothing was changed.")
+  const result = await platform.syncClaim("superAdmin", uid)
+  const after = await loadAuthUser(uid)
+  const verified = after.customClaims && after.customClaims.superAdmin === true
+  if (!verified) throw fail("The claim was not present after setting it. Investigate before continuing.")
+  if (result.changed) {
+    const batch = fb.db().batch()
+    writeAudit(batch, { action: "platform.superAdmin.bootstrap", actorUid: "bootstrap-script", targetUid: uid, details: { emailVerified: user.emailVerified === true, exception: user.emailVerified !== true } })
+    await batch.commit()
+  }
+  return { uid, email: user.email, claimChanged: result.changed, claimVerified: true, emailVerified: user.emailVerified === true, recordRole: record.role }
+}
+
+async function status() {
+  const snap = await fb.db().collection(COL.superAdmin).get()
+  const rows = []
+  for (const d of snap.docs) {
+    const r = d.data()
+    let user = null
+    try { user = await fb.auth().getUser(d.id) } catch (e) { if (!e || e.code !== "auth/user-not-found") throw e }
+    const claim = !!(user && user.customClaims && user.customClaims.superAdmin === true)
+    const problems = []
+    if (!user) problems.push("ORPHAN: no Authentication account")
+    if (r.uid !== d.id) problems.push("uid field != document id")
+    if (r.role !== "super_admin") problems.push(`role is "${r.role}"`)
+    if (r.active === true && user && !claim) problems.push("active but claim missing (run sync)")
+    if (r.active !== true && claim) problems.push("inactive but claim present (run sync)")
+    if (user && r.active === true && !user.emailVerified) problems.push("email not verified: admin powers inert until verified")
+    rows.push({ uid: d.id, email: r.email, active: r.active === true, claim, problems })
+  }
+  return rows
+}
+module.exports = { bootstrap, status, syncOne: (uid) => platform.syncClaim("superAdmin", uid), OLD_PROJECT, fail }
